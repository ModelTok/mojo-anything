        Entry(
            "    --no-backup",
            (
                "Change settings files in place without saving a"
                " `.mojo-anything.bak` copy first"
            ),
            False,
        )
    )
    c15.options.append(Entry("    --json", "", False))
    c15.options.append(
        Entry("-h, --help", "Print help (see more with '--help')", False)
    )
    all.append(c15^)
    var c16 = CommandSpec(
        path="map",
        about=(
            "Map the port: every unit of the original, the crate that ports it,"
            " its cases and last diff, the whole app's glue, and which"
            " recordings the original changed past since they were made. Commit"
            " the map (`--write`) to see upstream changes in it"
        ),
        usage="mojo-anything map [OPTIONS] [REPO]",
        after_help="",
        long_same=True,
    )
    c16.arguments.append(Entry("[REPO]", "Repository root [default: .]", False))
    c16.options.append(
        Entry(
            "    --crates <CRATES>",
            (
                "Also look for crates in this folder (crates kept outside the"
                " repository)"
            ),
            False,
        )
    )
    c16.options.append(
        Entry(
            "    --write",
            (
                "Write the map to mojo/PORT_MAP.md in the repository instead of"
                " printing it"
            ),
            False,
        )
    )
    c16.options.append(
        Entry(
            "    --check",
            "Exit 1 when the original changed since any port was recorded",
            False,
        )
    )
    c16.options.append(Entry("    --json", "", False))
    c16.options.append(Entry("-h, --help", "Print help", False))
    all.append(c16^)
    var c17 = CommandSpec(
        path="doctor",
        about=(
            "Check pixi and the pinned Mojo, the language runtimes, the agent"
            " setup and the MCP server, with the command that fixes each"
            " problem. Exits 1 when something required is missing"
        ),
        usage="mojo-anything doctor [OPTIONS]",
        after_help="",
        long_same=True,
    )
    c17.options.append(Entry("    --json", "", False))
    c17.options.append(Entry("-h, --help", "Print help", False))
    all.append(c17^)
    return all^


def long_help(path: String) -> String:
    """clap's `--help` for `path`, or "" for a path it does not know."""
    if path == "":
        return (
            "Rewrite TypeScript/JavaScript, Python, C, C++, Go, Ruby, Java or"
            " Kotlin apps in Mojo, one verified piece at a time\n\nUsage:"
            " mojo-anything <COMMAND>\n\nCommands:\n  analyze  1. Map a"
            " repository and write a ranked, ordered migration plan\n  bridge  "
            " 2. Scaffold the port of one unit, with the bindings its callers"
            " need\n  refresh  2b. Regenerate the bindings from the signatures"
            " in the port (`port.mojo`)\n  record   3a. Record what the TS"
            " functions return on generated and given inputs\n  build    3b."
            " Build the port (Node-API addon, Python extension, shared"
            " library)\n  diff     3c. Replay recorded cases against the built"
            " Mojo port\n  bench    3d. Time the recorded cases on the original"
            " and on the Mojo port, bridge included\n  fuzz     3e. Run fresh"
            " inputs from a new seed through the original and the port and"
            " report where they differ: what the recorded cases did not cover\n"
            "  profile  Run a real workload under the language's profiler and"
            " say what to port: hot functions, their callers, and loops to"
            " batch. `mojo-anything profile <repo> -- node bench.mjs` (also"
            " `python3 x.py`, `go test -bench . ./pkg`, `java ...`, `ruby"
            " x.rb`)\n  shadow   4. Generate a drop-in module that runs the"
            " original and the Mojo port side by side\n  gate     5. Check the"
            " definition of done for a port\n  package  6. Lay out installable"
            " packages and a CI workflow for every platform; never publishes\n "
            " app      Record the whole app's behavior and replay any build"
            " against it (CLIs)\n  mcp      Serve every step as MCP tools over"
            " stdio\n  setup    Register mojo-anything with your coding agents"
            " (Claude Code, Codex, Cursor, Gemini CLI, OpenCode): the MCP"
            " server and, where the agent reads skills, the workflow skill."
            " Keeps your other settings; run it again any time\n  map      Map"
            " the port: every unit of the original, the crate that ports it,"
            " its cases and last diff, the whole app's glue, and which"
            " recordings the original changed past since they were made. Commit"
            " the map (`--write`) to see upstream changes in it\n  doctor  "
            " Check pixi and the pinned Mojo, the language runtimes, the agent"
            " setup and the MCP server, with the command that fixes each"
            " problem. Exits 1 when something required is missing\n  help    "
            " Print this message or the help of the given"
            " subcommand(s)\n\nOptions:\n  -h, --help     Print help\n  -V,"
            " --version  Print version\n\nLoop per unit: analyze -> bridge ->"
            " record -> port port.mojo -> build -> diff -> shadow -> gate\n"
        )
    if path == "app":
        return (
            "Record the whole app's behavior and replay any build against it"
            " (CLIs)\n\nUsage: mojo-anything app <COMMAND>\n\nCommands:\n "
            " record      Run the original CLI on cases (its own examples,"
            " `--inputs`, semantic traps), twice each, and store them as trycmd"
            " files in `<repo>/mojo/app-cases/`. `mojo-anything app record . --"
            " python3 cli.py`\n  replay      Run a build against"
            " `<repo>/mojo/app-cases/`, print passed/total, write a report with"
            " a diff per failing case; exits non-zero on any mismatch\n "
            " front-door  Scaffold `<repo>/mojo/app`, the Mojo binary that owns"
            " the CLI's entry point: it routes the recorded commands and"
            " options, every command running the original until a unit is"
            " wired. Builds it and replays the cases (every case passes, every"
            " case falling back)\n  wire        Hand commands to a unit's port"
            " (after it passes gate): adds the unit to `mojo/app`, a glue file"
            " to write once (a CLI), the routing and a kill switch"
            " (`MOJO_ANYTHING_UNIT_<NAME>=original`), then builds and replays."
            " A CLI or a library takes a Mojo unit (`mojo/<name>` with"
            " `port.mojo`); a server takes one for each route\n  lift       "
            " Make `mojo/app` a pure app (a Mojo binary for a CLI), once replay"
            " passes with fallback rate 0 and every unit passes gate: removes"
            " the fallback and the kill switches, strips the units' bridges,"
            " runs the lift checklist and replays the pure binary. Checked on a"
            " copy first; the original stays in place\n  help        Print this"
            " message or the help of the given subcommand(s)\n\nOptions:\n  -h,"
            " --help  Print help\n"
        )
    if path == "analyze":
        return (
            "1. Map a repository and write a ranked, ordered migration"
            " plan\n\nUsage: mojo-anything analyze [OPTIONS]"
            " [ROOT]\n\nArguments:\n  [ROOT]  Repository root [default:"
            " .]\n\nOptions:\n      --json         Print the machine-readable"
            " report (schema `mojo-anything/analyze@1`) instead of Markdown\n "
            " -o, --out <OUT>    Write to this file instead of stdout\n     "
            " --lang <LANG>  Source language; detected from the repository when"
            " omitted [possible values: ts, python, c, go, ruby, java, kotlin,"
            " php, csharp, cpp]\n      --whole-app    Plan a whole-app port:"
            " entry points and shape, every dependency (imported or declared)"
            " with its crate, pieces in port order, and decisions for the"
            " user\n  -h, --help         Print help\n"
        )
    if path == "bridge":
        return (
            "2. Scaffold the port of one unit, with the bindings its callers"
            " need\n\nUsage: mojo-anything bridge [OPTIONS] <ROOT>"
            " <UNIT>\n\nArguments:\n  <ROOT>\n          Repository root\n\n "
            " <UNIT>\n          Unit id, as `analyze` lists it\n\nOptions:\n   "
            "   --kind <KIND>\n          Bridge to generate; defaults to the"
            " plan's choice\n\n          Possible values:\n          - node: A"
            " Mojo port behind a Node-API addon\n          - wasm: A Mojo port"
            " compiled to a WebAssembly module (wasm64), loaded by"
            " `index.cjs`\n\n  -o, --out <OUT>\n          Port folder; defaults"
            " to `<root>/mojo/<name>`\n\n      --name <NAME>\n          Port"
            " name; defaults to `<unit>-mojo`\n\n      --force\n         "
            " Bridge a unit the plan marks blocked or keep\n\n      --keep"
            ' <KEEP>\n          Keep an export in TS: `name` or `"name:'
            ' reason"`. Repeatable\n\n      --batch <BATCH>\n          Add a'
            " batch class: `function:param` runs `function` over many `param`"
            " values kept on the native side (what `profile` recommends for"
            " leaves called in loops)\n\n      --as-json <TYPE_PARAM>\n        "
            "  Bridge a type parameter as JSON values (`--as-json T`) when the"
            " app only fills it with data, instead of keeping the generic"
            " export in TS. Repeatable\n\n  -h, --help\n          Print help"
            " (see a summary with '-h')\n"
        )
    if path == "refresh":
        return (
            "2b. Regenerate the bindings from the signatures in the port"
            " (`port.mojo`)\n\nUsage: mojo-anything refresh [OPTIONS]"
            " [CRATE_DIR]\n\nArguments:\n  [CRATE_DIR]  [default:"
            " .]\n\nOptions:\n      --batch <BATCH>  Add a batch class:"
            " `function:param` runs `function` over many `param` values kept on"
            " the native side. Repeat for more\n  -h, --help           Print"
            " help\n"
        )
    if path == "record":
        return (
            "3a. Record what the TS functions return on generated and given"
            " inputs\n\nUsage: mojo-anything record [OPTIONS] [CRATE_DIR] [--"
            " <TEST_COMMAND>...]\n\nArguments:\n  [CRATE_DIR]\n          Crate"
            " folder made by `bridge`\n          \n          [default: .]\n\n "
            " [TEST_COMMAND]...\n          The test command for `--from-tests`,"
            " after `--`; it runs in the original's folder\n\nOptions:\n     "
            " --count <COUNT>\n          Generated cases per function\n        "
            "  \n          [default: 200]\n\n      --inputs <INPUTS>\n         "
            ' Extra cases: JSONL of `{"fn": name, "args": [...]}`\n\n     '
            " --module <MODULE>\n          Import the original from this JS"
            " module (e.g. built output) instead of the TS source\n\n     "
            " --resolve-from <RESOLVE_FROM>\n          Resolve npm packages"
            " from this folder's `node_modules` (when the repo has none"
            " installed)\n\n      --node-arg <NODE_ARGS>\n          Extra"
            " arguments for node, e.g. `--node-arg=--import=tsx`\n\n     "
            " --float-tolerance <FLOAT_TOLERANCE>\n          Floats match when"
            " they differ by at most this times the larger magnitude (absolute"
            " below 1), e.g. 1e-9 for numeric code. Saved with the crate for"
            " diff and gate; 0 removes it\n\n      --from-tests\n          Also"
            " record every call the original's own test suite makes to the"
            " unit's functions: `--from-tests -- npx jest` (TS/JS, any runner)"
            " or `-- pytest` (Python)\n\n      --profile <PROFILE>\n         "
            " Target: this machine\n\n          Possible values:\n          -"
            " host: This machine\n          \n          [default: host]\n\n    "
            "  --pin-clock\n          Pin the clock and random numbers while"
            " recording and diffing (TS/JS with the node bridge, Python):"
            " `Date.now()`, `new Date()` and `Math.random` (`time.time`,"
            " `datetime.now` and `random`) get fixed values, saved in"
            " `pinned.json`, and the port reads them from `pinned.mojo`. Kept"
            " for later runs until `--no-pin-clock`\n\n      --no-pin-clock\n  "
            "        Stop pinning the clock and random numbers\n\n  -h,"
            " --help\n          Print help (see a summary with '-h')\n"
        )
    if path == "build":
        return (
            "3b. Build the port (Node-API addon, Python extension, shared"
            " library)\n\nUsage: mojo-anything build [OPTIONS]"
            " [CRATE_DIR]\n\nArguments:\n  [CRATE_DIR]\n          [default:"
            " .]\n\nOptions:\n      --profile <PROFILE>\n          Target: this"
            " machine\n\n          Possible values:\n          - host: This"
            " machine\n          \n          [default: host]\n\n  -h, --help\n "
            "         Print help (see a summary with '-h')\n"
        )
    if path == "diff":
        return (
            "3c. Replay recorded cases against the built Mojo port\n\nUsage:"
            " mojo-anything diff [OPTIONS] [CRATE_DIR]\n\nArguments:\n "
            " [CRATE_DIR]\n          [default: .]\n\nOptions:\n      --profile"
            " <PROFILE>\n          Target: this machine\n\n          Possible"
            " values:\n          - host: This machine\n          \n         "
            " [default: host]\n\n      --module <MODULE>\n          Test this"
            " JS module instead of the crate's `index.cjs`\n\n     "
            " --ignore-key-order\n          Compare objects regardless of key"
            " order\n\n      --float-tolerance <FLOAT_TOLERANCE>\n         "
            " Floats match within this tolerance for this run (the one saved by"
            " `record` otherwise)\n\n      --json\n          \n\n     "
            " --node-arg <NODE_ARGS>\n          \n\n  -h, --help\n         "
            " Print help (see a summary with '-h')\n"
        )
    if path == "bench":
        return (
            "3d. Time the recorded cases on the original and on the Mojo port,"
            " bridge included\n\nUsage: mojo-anything bench [OPTIONS]"
            " [CRATE_DIR]\n\nArguments:\n  [CRATE_DIR]  [default:"
            " .]\n\nOptions:\n      --min-ms <MIN_MS>              Minimum"
            " measured time per function and side, in milliseconds [default:"
            " 200]\n      --resolve-from <RESOLVE_FROM>  Resolve npm packages"
            " the original imports from this folder's `node_modules`\n     "
            " --json                         \n      --node-arg <NODE_ARGS>    "
            "     \n  -h, --help                         Print help\n"
        )
    if path == "fuzz":
        return (
            "3e. Run fresh inputs from a new seed through the original and the"
            " port and report where they differ: what the recorded cases did"
            " not cover\n\nUsage: mojo-anything fuzz [OPTIONS]"
            " [CRATE_DIR]\n\nArguments:\n  [CRATE_DIR]\n          [default:"
            " .]\n\nOptions:\n      --cases <CASES>\n          Fresh cases per"
            " function (and scenarios per class) in each round\n          \n   "
            "       [default: 200]\n\n      --seed <SEED>\n          Seed of"
            " the first round; random (and printed) when omitted. Later rounds"
            " count up\n\n      --time <SECS>\n          Keep running new"
            " rounds until this many seconds have passed (one round"
            " otherwise)\n\n      --keep[=<KEEP>]\n          Append the"
            " mismatching cases (`--keep`) or every fresh case (`--keep=all`)"
            " to `cases.jsonl`, so the next diff and gate check them\n\n       "
            "   Possible values:\n          - mismatches: Only the cases where"
            " the port differs from the original\n          - all:        Every"
            " fresh case\n\n      --resolve-from <RESOLVE_FROM>\n         "
            " Resolve npm packages the original imports from this folder's"
            " `node_modules`\n\n      --json\n          \n\n      --node-arg"
            " <NODE_ARGS>\n          \n\n  -h, --help\n          Print help"
            " (see a summary with '-h')\n"
        )
    if path == "profile":
        return (
            "Run a real workload under the language's profiler and say what to"
            " port: hot functions, their callers, and loops to batch."
            " `mojo-anything profile <repo> -- node bench.mjs` (also `python3"
            " x.py`, `go test -bench . ./pkg`, `java ...`, `ruby"
            " x.rb`)\n\nUsage: mojo-anything profile [OPTIONS] <ROOT> --"
            " <COMMAND>...\n\nArguments:\n  <ROOT>        Repository root\n "
            " <COMMAND>...  The workload, after `--`\n\nOptions:\n      --json "
            "        \n      --lang <LANG>  Source language; detected from the"
            " repository when omitted [possible values: ts, python, c, go,"
            " ruby, java, kotlin, php, csharp, cpp]\n  -h, --help         Print"
            " help\n"
        )
    if path == "shadow":
        return (
            "4. Generate a drop-in module that runs the original and the Mojo"
            " port side by side\n\nUsage: mojo-anything shadow [OPTIONS]"
            " [CRATE_DIR]\n\nArguments:\n  [CRATE_DIR]  [default:"
            " .]\n\nOptions:\n  -o, --out <OUT>  Where to write the module;"
            " defaults to `<crate>/shadow/<name>.shadow.ts`\n  -h, --help      "
            " Print help\n"
        )
    if path == "gate":
        return (
            "5. Check the definition of done for a port\n\nUsage: mojo-anything"
            " gate [OPTIONS] [CRATE_DIR]\n\nArguments:\n  [CRATE_DIR] "
            " [default: .]\n\nOptions:\n      --json                  \n     "
            " --node-arg <NODE_ARGS>  \n  -h, --help                  Print"
            " help\n"
        )
    if path == "package":
        return (
            "6. Lay out installable packages and a CI workflow for every"
            " platform; never publishes\n\nUsage: mojo-anything package"
            " [OPTIONS] [CRATE_DIR]\n\nArguments:\n  [CRATE_DIR]  [default:"
            " .]\n\nOptions:\n      --name <NAME>        Package name (npm,"
            " PyPI, RubyGems, Maven artifact); defaults to the unit's name\n   "
            "   --version <VERSION>  Package version; defaults to the original"
            " package's\n      --out <OUT>          Output folder; defaults to"
            " `<crate>/package`\n      --dry-run            List the files,"
            " write nothing\n      --json               \n  -h, --help         "
            "      Print help\n"
        )
    if path == "mcp":
        return (
            "Serve every step as MCP tools over stdio\n\nUsage: mojo-anything"
            " mcp\n\nOptions:\n  -h, --help  Print help\n"
        )
    if path == "setup":
        return (
            "Register mojo-anything with your coding agents (Claude Code,"
            " Codex, Cursor, Gemini CLI, OpenCode): the MCP server and, where"
            " the agent reads skills, the workflow skill. Keeps your other"
            " settings; run it again any time\n\nUsage: mojo-anything setup"
            " [OPTIONS]\n\nOptions:\n      --agent <AGENTS>\n          Agents"
            " to set up (repeatable); every agent found by default\n\n         "
            " Possible values:\n          - claude:   Claude Code:"
            " `~/.claude.json`, skill in `~/.claude/skills`\n          - codex:"
            "    OpenAI Codex CLI: `~/.codex/config.toml`, skill in"
            " `~/.codex/skills`\n          - cursor:   Cursor:"
            " `~/.cursor/mcp.json`\n          - gemini:   Gemini CLI:"
            " `~/.gemini/settings.json`\n          - opencode: OpenCode:"
            " `~/.config/opencode/opencode.json`, skill in"
            " `~/.config/opencode/skills`\n\n      --remove\n          Take the"
            " mojo-anything entries out again\n\n      --dry-run\n         "
            " Show what would change, write nothing\n\n      --no-backup\n     "
            "     Change settings files in place without saving a"
            " `.mojo-anything.bak` copy first\n\n      --json\n          \n\n "
            " -h, --help\n          Print help (see a summary with '-h')\n"
        )
    if path == "map":
        return (
            "Map the port: every unit of the original, the crate that ports it,"
            " its cases and last diff, the whole app's glue, and which"
            " recordings the original changed past since they were made. Commit"
            " the map (`--write`) to see upstream changes in it\n\nUsage:"
            " mojo-anything map [OPTIONS] [REPO]\n\nArguments:\n  [REPO] "
            " Repository root [default: .]\n\nOptions:\n      --crates <CRATES>"
            "  Also look for crates in this folder (crates kept outside the"
            " repository)\n      --write            Write the map to"
            " mojo/PORT_MAP.md in the repository instead of printing it\n     "
            " --check            Exit 1 when the original changed since any"
            " port was recorded\n      --json             \n  -h, --help       "
            "      Print help\n"
        )
    if path == "doctor":
        return (
            "Check pixi and the pinned Mojo, the language runtimes, the agent"
            " setup and the MCP server, with the command that fixes each"
            " problem. Exits 1 when something required is missing\n\nUsage:"
            " mojo-anything doctor [OPTIONS]\n\nOptions:\n      --json  \n  -h,"
            " --help  Print help\n"
        )
    if path == "app record":
        return (
            "Run the original CLI on cases (its own examples, `--inputs`,"
            " semantic traps), twice each, and store them as trycmd files in"
            " `<repo>/mojo/app-cases/`. `mojo-anything app record . -- python3"
            " cli.py`\n\nUsage: mojo-anything app record [OPTIONS] [REPO] [--"
            " <RUN>...]\n\nArguments:\n  [REPO]    Repository root [default:"
            " .]\n  [RUN]...  The command that runs the original, after `--`;"
            " paths are relative to the repository. Taken from the saved cases"
            " when omitted\n\nOptions:\n      --inputs <INPUTS>\n         "
            ' Extra cases: JSONL of `{"name", "args": [...], "stdin", "env":'
            ' {...}, "files": {path: text}}`\n      --normalize <NORMALIZE>\n  '
            "        Normalizer: `timestamps`, `uuids`, `key-order`, or"
            " `name=regex` for your own. Repeatable; saved with the cases\n    "
            "  --name <NAME>\n          The name the app is invoked by in its"
            " docs (found from the command and manifests when omitted)\n     "
            " --no-traps\n          Leave out the semantic-trap inputs\n     "
            " --timeout <TIMEOUT>\n          Seconds before a run is killed"
            " (default 30)\n      --http\n          The app is a server: the"
            " command starts it, taking its port from PORT or `{port}`; cases"
            " are requests (curl lines in its docs, `--inputs`, traps), kept in"
            " `http/`\n      --port <PORT>\n          A port the server always"
            " listens on (implies --http)\n      --arg <ARG>\n          An"
            " argument every server start gets after its command, the"
            " original's and every build's (`{port}` is the port each one is"
            " given: the front door's public port, and its original's own),"
            " so a build is started as the original is (`--arg db.json`)."
            " Repeatable; implies --http; saved with the cases\n      --fresh"
            " <FRESH>\n          A file or folder of the repository the app"
            " reads or writes (a project tree, a database file, a public"
            " folder): snapshotted into `files/` (`http/files/` for a server)"
            " and copied into a fresh working directory before every case"
            " (CLIs) or start (servers). A CLI's written files are what"
            " differs from it afterwards, and the files it removed are compared"
            " too. Repeatable; saved with the cases\n      --pace <MS>\n       "
            "   Milliseconds to wait after each response before the next"
            " request, for work a server does after answering (a file watcher"
            " reloading what it just wrote). Implies --http; saved with the"
            " cases and used by replay; 0 removes it\n      --float-tolerance"
            " <FLOAT_TOLERANCE>\n          Numbers in the output match when"
            " they differ by at most this times the larger magnitude (absolute"
            " below 1), e.g. 1e-9 for numeric code. Saved with the cases; 0"
            " removes it\n      --float-file <PATH=FORMAT>\n          A written"
            " file of raw floats, compared value by value within"
            " --float-tolerance instead of byte for byte: `PATH=f32le` or"
            " `PATH=f64le`. Repeatable; saved with the cases\n      --effects"
            " <KINDS>\n          Record what leaves the process too: `http`"
            " runs a local sink that answers every request (set as HTTP_PROXY,"
            " http_proxy and MOJO_ANYTHING_HTTP_SINK), `smtp` a local mail"
            " server (SMTP_HOST, SMTP_PORT). Each case stores what reached"
            " them, in order, and replay compares it. Comma-separated or"
            " repeated. Saved with the cases\n      --effect-env <VAR=KIND>\n  "
            "        Point one of the app's own settings at a sink:"
            " VAR=http-url, VAR=smtp-host, VAR=smtp-port or VAR=smtp-url (e.g."
            " WEBHOOK_URL=http-url). Implies that effect\n      --db-reset"
            " <COMMAND>\n          A shell command run before each case (CLIs)"
            " or each start (servers) that resets the database to a known"
            " state. Cases then run one at a time\n      --db-dump <COMMAND>\n "
            "         A shell command that prints the database's state (e.g."
            " `sqlite3 app.db .dump`), run after each case or request; its"
            " output is recorded with the effects\n      --json\n          \n "
            " -h, --help\n          Print help\n"
        )
    if path == "app replay":
        return (
            "Run a build against `<repo>/mojo/app-cases/`, print passed/total,"
            " write a report with a diff per failing case; exits non-zero on"
            " any mismatch\n\nUsage: mojo-anything app replay [OPTIONS]"
            " [REPO]\n\nArguments:\n  [REPO]  Repository root [default:"
            " .]\n\nOptions:\n      --build <BUILD>      Command line of the"
            " build to test (the original, the front door, the final binary);"
            " the original when omitted\n      --timeout <TIMEOUT>  Seconds"
            " before a run is killed\n      --port <PORT>        Servers: the"
            " port the build always listens on; otherwise it gets a free one"
            " through PORT and `{port}`\n      --case <CASE>        Replay only"
            " this case, by the name the report gives it (a library: only this"
            " unit). The fast, repeatable loop for fixing one mismatch\n     "
            " --json               \n  -h, --help               Print help\n"
        )
    if path == "app front-door":
        return (
            "Scaffold `<repo>/mojo/app`, the Mojo binary that owns the CLI's"
            " entry point: it routes the recorded commands and options, every"
            " command running the original until a unit is wired. Builds it and"
            " replays the cases (every case passes, every case falling"
            " back)\n\nUsage: mojo-anything app front-door [OPTIONS]"
            " [REPO]\n\nArguments:\n  [REPO]  Repository root [default:"
            " .]\n\nOptions:\n      --no-check  Only write the files; skip the"
            " build and replay\n      --library   Treat the repository as a"
            " library even if it has a `main`: the front door is a Mojo package"
            " with the public API (found by default when there is no main and"
            " no server)\n      --json      \n  -h, --help      Print help\n"
        )
    if path == "app wire":
        return (
            "Hand commands to a unit's port (after it passes gate): adds the"
            " unit to `mojo/app`, a glue file to write once (a CLI), the"
            " routing and a kill switch (`MOJO_ANYTHING_UNIT_<NAME>=original`),"
            " then builds and replays. A CLI or a library takes a Mojo unit"
            " (`mojo/<name>` with `port.mojo`); a server takes one for each"
            " route\n\nUsage: mojo-anything app wire [OPTIONS] <REPO>"
            " <UNIT>\n\nArguments:\n  <REPO>  Repository root\n  <UNIT>  The"
            " unit: its folder, its name under `mojo/`, or the unit id it was"
            " bridged from\n\nOptions:\n      --command <COMMANDS>  A command"
            " the unit answers. Repeatable; kept from the last wire when"
            " omitted\n      --route <ROUTES>      Servers: a route the unit"
            " answers (`GET /users/{id}`, `/files/{*rest}`, `/path` for any"
            " method, `*` for everything else). Repeatable; kept from the last"
            " wire when omitted\n      --skip-gate           Do not run gate on"
            " the unit first (it just passed)\n      --no-check            Only"
            " write the files; skip the build and replay\n      --json         "
            "       \n  -h, --help                Print help\n"
        )
    if path == "app lift":
        return (
            "Make `mojo/app` a pure app (a Mojo binary for a CLI), once replay"
            " passes with fallback rate 0 and every unit passes gate: removes"
            " the fallback and the kill switches, strips the units' bridges,"
            " runs the lift checklist and replays the pure binary. Checked on a"
            " copy first; the original stays in place\n\nUsage: mojo-anything"
            " app lift [OPTIONS] [REPO]\n\nArguments:\n  [REPO]  Repository"
            " root [default: .]\n\nOptions:\n      --json  \n  -h, --help "
            " Print help\n"
        )
    return ""
