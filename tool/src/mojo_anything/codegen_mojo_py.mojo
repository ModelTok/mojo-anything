# A Python unit ported to Mojo (port of src/codegen_mojo_py.rs and the
# Python half of bridge.rs): the extension module `_native.mojo` over
# `port.mojo`, the unit's `pixi.toml`, the wrapper package Python code imports
# in place of the original, and the unit's README.

from mojo_anything.codegen_mojo import (
    Manifest,
    PortApi,
    PortFn,
    has_literal_default,
    join,
    mojo_ident,
)

comptime NATIVE = "_native"
comptime BYTES = "List[UInt8]"
comptime MOJO_VERSION = "1.2.0"


def needs_py_num(api: PortApi) -> Bool:
    for f in api.functions:
        if f.ret.find("PyNum") >= 0:
            return True
        for t in f.param_types:
            if t.find("PyNum") >= 0:
                return True
    return False


def unit_pixi_toml(m: Manifest, json: Bool) -> String:
    var preview = String("")
    var dep = String("")
    if json:
        preview = 'preview = ["pixi-build"]\n'
        dep = (
            'emberjson = { git = "https://github.com/bgreni/EmberJson.git", tag'
            ' = "0.5.0" }\n'
        )
    return String(
        "# Generated by mojo-anything: the Mojo this port builds with.\n",
        '[workspace]\nname = "',
        m.crate_name,
        '"\nchannels = ["https://conda.modular.com/max", "conda-forge"]\n',
        'platforms = ["linux-64", "linux-aarch64", "osx-arm64"]\n',
        preview,
        '\n[dependencies]\nmojo = "==',
        MOJO_VERSION,
        '"\n',
        dep,
    )


def pixi_toml(m: Manifest) -> String:
    return unit_pixi_toml(m, False)


def mangle(ty: String) -> String:
    var out = String("")
    for b in ty.as_bytes():
        if b == 32 or (b >= 9 and b <= 13) or b == 93:
            continue
        if b == 91:
            out += "_"
        else:
            out += chr(Int(b))
    return out


def _inner(ty: String, wrapper: String) -> Optional[String]:
    var head = wrapper + "["
    if ty.startswith(head) and ty.endswith("]"):
        return String(ty[byte = head.byte_length() : ty.byte_length() - 1])
    return None


def _expect(types: String, what: String) -> String:
    return String(
        'var b = Python.import_module("builtins")\n    if not b.isinstance(v, ',
        types,
        '):\n        raise Error(String("expected ',
        what,
        ', got ", b.type(v).__name__))\n    ',
    )


struct Converters(Movable):
    var text: String
    var done: List[String]

    def __init__(out self):
        self.text = String("")
        self.done = List[String]()


def from_py(mut conv: Converters, ty: String) raises -> String:
    var name = "_from_py_" + mangle(ty)
    if name in conv.done:
        return name
    var body: String
    if ty == "PythonObject":
        body = "return v"
    elif ty == "PyNum":
        body = (
            _expect("Python.tuple(b.int, b.float)", "a number")
            + "return PyNum(py=v)"
        )
    elif ty == "String":
        body = _expect("b.str", "a str") + "return String(py=v)"
    elif ty == "Float64":
        body = (
            _expect("Python.tuple(b.int, b.float)", "a number")
            + "return Float64(py=v)"
        )
    elif ty == "Int":
        body = _expect("b.int", "an int") + "return Int(py=v)"
    elif ty == "Bool":
        body = _expect("b.bool", "a bool") + "return Bool(v)"
    elif ty == BYTES:
        body = (
            _expect(
                "Python.tuple(b.bytes, b.bytearray, b.memoryview)",
                "a bytes-like object",
            )
            + "var items = List[UInt8](capacity=Int(py=b.len(v)))\n    for"
            " item in b.bytes(v):\n        items.append(UInt8(Int(py=item)))\n "
            "   return items^"
        )
    else:
        var l = _inner(ty, "List")
        var o = _inner(ty, "Optional")
        if l:
            var t = l.value()
            var item = from_py(conv, t)
            body = String(
                _expect("b.list", "a list"),
                "var items = List[",
                t,
                "]()\n    for item in v:\n        items.append(",
                item,
                "(item))\n    return items^",
            )
        elif o:
            var t = o.value()
            var value = from_py(conv, t)
            body = String(
                "if v is Python.none():\n        return Optional[",
                t,
                "](None)\n    return Optional[",
                t,
                "](",
                value,
                "(v))",
            )
        else:
            raise Error(String("`", ty, "` cannot cross the Python bridge"))
    conv.text += String(
        "\n\ndef ",
        name,
        "(v: PythonObject) raises -> ",
        ty,
        ":\n    ",
        body,
        "\n",
    )
    conv.done.append(name)
    return name


def to_py(mut conv: Converters, ty: String) raises -> String:
    var name = "_to_py_" + mangle(ty)
    if name in conv.done:
        return name
    var body: String
    if ty == "PythonObject":
        body = "return v"
    elif ty == "PyNum":
        body = "return v.to_python()"
    elif ty == "String" or ty == "Float64" or ty == "Int" or ty == "Bool":
        body = "return PythonObject(v)"
    elif ty == BYTES:
        body = (
            'var b = Python.import_module("builtins")\n    var items ='
            " Python.list()\n    for item in v:\n        _ ="
            " items.append(PythonObject(Int(item)))\n    return b.bytes(items)"
        )
    else:
        var l = _inner(ty, "List")
        var o = _inner(ty, "Optional")
        if l:
            var item = to_py(conv, l.value())
            body = String(
                (
                    "var items = Python.list()\n    for item in v:\n        _ ="
                    " items.append("
                ),
                item,
                "(item))\n    return items",
            )
        elif o:
            var value = to_py(conv, o.value())
            body = String(
                "if not v:\n        return Python.none()\n    return ",
                value,
                "(v.value())",
            )
        else:
            raise Error(String("`", ty, "` cannot cross the Python bridge"))
    conv.text += String(
        "\n\ndef ",
        name,
        "(v: ",
        ty,
        ") raises -> PythonObject:\n    ",
        body,
        "\n",
    )
    conv.done.append(name)
    return name


def _binding(mut text: String, mut conv: Converters, f: PortFn) raises:
    var params = List[String]()
    for n in f.param_names:
        params.append("p_" + n + ": PythonObject")
    text += String(
        "\n\ndef _bind_",
        f.rust_name,
        "(",
        join(params, ", "),
        ") raises -> PythonObject:\n",
    )
    for k in range(len(f.param_names)):
        var n = f.param_names[k]
        var t = f.param_types[k]
        var fr: String
        try:
            fr = from_py(conv, t)
        except e:
            raise Error(String("`", f.rust_name, "`: ", e))
        text += String("    var a_", n, ": ", t, "\n")
        text += String(
            "    try:\n        a_",
            n,
            " = ",
            fr,
            "(p_",
            n,
            ')\n    except e:\n        raise Error(String("TypeError: ", e))\n',
        )
    var args = List[String]()
    for n in f.param_names:
        args.append("a_" + n)
    var call = String("port.", f.rust_name, "(", join(args, ", "), ")")
    if f.ret == "None":
        text += String("    ", call, "\n    return Python.none()\n")
    else:
        var to: String
        try:
            to = to_py(conv, f.ret)
        except e:
            raise Error(String("`", f.rust_name, "`: ", e))
        text += String("    return ", to, "(", call, ")\n")


def native_mojo(m: Manifest, api: PortApi) raises -> String:
    var out = String(
        "# Python bindings for the Mojo port of `",
        m.unit,
        "`, generated by mojo-anything from the\n",
        (
            "# signatures in `port.mojo`. Regenerate with `mojo-anything"
            " refresh` after changing them.\n\n"
        ),
        "from std.os import abort\n\n",
        "from std.python import Python, PythonObject\n",
        "from std.python.bindings import PythonModuleBuilder\n\n",
        "import port\n",
    )
    if needs_py_num(api):
        out += "from py_num import PyNum\n"
    out += String(
        "\n\n@export\ndef PyInit_",
        NATIVE,
        (
            '() abi("C") -> PythonObject:\n    try:\n        var module ='
            ' PythonModuleBuilder("'
        ),
        NATIVE,
        '")\n',
    )
    for f in api.functions:
        out += String(
            "        module.def_function[_bind_",
            f.rust_name,
            ']("',
            f.js_name,
            '")\n',
        )
    out += (
        "        return module.finalize()\n    except e:\n       "
        ' abort(String("failed to create the Python module: ", e))\n'
    )
    var conv = Converters()
    for f in api.functions:
        _binding(out, conv, f)
    out += conv.text
    return out


comptime CALL_PY = """
import builtins as _builtins


def _call(f, *args):
    try:
        return f(*args)
    except Exception as e:
        # Mojo raises every error as `Exception`; `Name: message` names the exception to raise.
        if type(e) is not Exception:
            raise
        name, sep, message = str(e).partition(": ")
        cls = getattr(_builtins, name, None)
        if not (sep and isinstance(cls, type) and issubclass(cls, BaseException)):
            raise
        # Some builtins take several arguments (`UnicodeDecodeError`): use the nearest base
        # that takes a message alone.
        for base in cls.__mro__:
            try:
                error = base(message)
            except TypeError:
                continue
            raise error from None
        raise
"""


def package_init_mojo(
    m: Manifest, api: PortApi, kept_modules: List[String]
) -> String:
    """`__init__.py` of the wrapper package; `kept_modules` holds
    package::python_module_path of each class and then each js_only entry, in
    that order."""
    var out = String(
        '"""Mojo port of `',
        m.unit,
        "`, generated by mojo-anything. Import this package where the code\n",
        'imported the original module."""\n\nfrom . import ',
        NATIVE,
        "\n",
        CALL_PY,
    )
    var names = List[String]()
    for f in api.functions:
        var params = List[String]()
        var found = -1
        for i in range(len(m.exports)):
            if (
                m.exports[i].name == f.js_name
                or mojo_ident(m.exports[i].name) == f.rust_name
            ):
                found = i
                break
        if found >= 0:
            for p in m.exports[found].params:
                if has_literal_default(p):
                    params.append(p.name + "=" + p.default.value())
                elif p.optional or p.default:
                    params.append(p.name + "=None")
                else:
                    params.append(p.name)
        else:
            for n in f.param_names:
                params.append(n)
        var call = List[String]()
        call.append(NATIVE + "." + f.js_name)
        for p in params:
            var eq = p.find("=")
            if eq >= 0:
                call.append(String(p[byte=0:eq]))
            else:
                call.append(p)
        out += String(
            "\n\ndef ",
            f.js_name,
            "(",
            join(params, ", "),
            "):\n    return _call(",
            join(call, ", "),
            ")\n",
        )
        names.append('"' + f.js_name + '"')
    var kept = List[String]()
    for c in m.classes:
        kept.append(c.name)
    for j in m.js_only:
        kept.append(j.name)
    if len(kept) > 0:
        var table = List[String]()
        for i in range(len(kept)):
            table.append(
                String('    "', kept[i], '": "', kept_modules[i], '",')
            )
        out += String(
            (
                "\n\n# Not ported: these stay in Python and come from the"
                " original module.\n_KEPT = {\n"
            ),
            join(table, "\n"),
            (
                "\n}\n\n\ndef __getattr__(name):\n    if name in _KEPT:\n      "
                "  import importlib\n\n        try:\n            module ="
                " importlib.import_module(_KEPT[name])\n        except"
                " ImportError as error:\n            raise AttributeError(\n   "
                '             f"{name!r} stays in Python, in {_KEPT[name]},'
                ' which cannot be imported: {error}"\n            ) from'
                " error\n        return getattr(module, name)\n    raise"
                ' AttributeError(f"module {__name__!r} has no attribute'
                ' {name!r}")\n'
            ),
        )
        for k in kept:
            names.append('"' + k + '"')
    out += String("\n\n__all__ = [", join(names, ", "), "]\n")
    return out


def mojo_readme(m: Manifest) -> String:
    var out = String(
        "# ",
        m.crate_name,
        "\n\nMojo port of `",
        m.unit,
        (
            "`, a Python extension module. Generated by mojo-anything.\n\n##"
            " Functions\n\n"
        ),
    )
    for f in m.exports:
        out += String("- `", f.name, "` (`", f.file, ":", f.line, "`)\n")
    out += (
        "\n## Loop\n\n```sh\nmojo-anything record .   # record what the Python"
        " code does\nmojo-anything build .    # build the Mojo extension"
        " module\nmojo-anything diff .     # replay the recorded cases against"
        " Mojo\nmojo-anything gate .     # format, warnings, tests, ported,"
        " API, diff\n```\n"
    )
    return out


comptime GITIGNORE = ".pixi/\n.mojo-anything/\n*.so\n__pycache__/\n"


def mojo_py_bindings(
    m: Manifest,
    api: PortApi,
    kept_modules: List[String],
    py_num: String,
    mut paths: List[String],
    mut texts: List[String],
) raises:
    """bridge.rs `mojo_py_bindings`: appends each file's path and text."""
    var native = native_mojo(m, api)
    paths.append(NATIVE + ".mojo")
    texts.append(native)
    paths.append("python/" + m.lib_name() + "/__init__.py")
    texts.append(package_init_mojo(m, api, kept_modules))
    if needs_py_num(api):
        paths.append("py_num.mojo")
        texts.append(py_num)
