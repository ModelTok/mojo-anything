# Ruby: the Fiddle module that calls the Mojo library and the wrapper with
# the original module functions (port of src/codegen_ruby.rs `native` and
# `wrapper`, and ruby.rs `receiver` and `signature`).

from mojo_anything.codegen_mojo import ExportedFn, Manifest, join, lines
from mojo_anything.codegen_mojo_c import BUILD_DIR
from mojo_anything.embedded import ruby_codec, ruby_native


def _indent(depth: Int) -> String:
    var out = String("")
    for _ in range(depth):
        out += "  "
    return out


def receiver(f: ExportedFn) -> List[String]:
    """The receiver and method name of an export: `Textkit::Words`,
    `slugify`."""
    var proto = f.prototype.or_else(f.name)
    var head = proto
    var open = proto.find("(")
    if open >= 0:
        head = String(proto[byte=0:open])
    var out = List[String]()
    var dot = head.rfind(".")
    if dot >= 0:
        out.append(String(head[byte=0:dot]))
        out.append(String(head[byte = dot + 1 :]))
    else:
        out.append("Object")
        out.append(f.name)
    return out^


def signature(f: ExportedFn) -> String:
    """The parameter list as written."""
    var proto = f.prototype.or_else("")
    var open = proto.find("(")
    if open < 0:
        return ""
    var rest = String(proto[byte = open + 1 :])
    if rest.endswith(")"):
        return String(rest[byte = 0 : rest.byte_length() - 1])
    return rest


def camel(lib: String) -> String:
    var out = String("")
    for part in lib.split("_"):
        var p = String(part)
        if p.byte_length() == 0:
            continue
        out += String(p[byte=0:1]).upper() + String(p[byte=1:])
    return out


def native(m: Manifest) -> String:
    """`ruby/<lib>_native.rb`: the codec and the module that calls the Mojo
    library through Fiddle."""
    var lib = m.lib_name()
    var body = (
        ruby_native()
        .replace("@CAMEL@", camel(lib))
        .replace("@BUILD@", BUILD_DIR)
        .replace("@LIB@", lib)
    )
    return String(
        "# frozen_string_literal: true\n\n",
        "# Calls the Mojo port of `",
        m.unit,
        "` (the library `lib",
        lib,
        "`) through Fiddle. Generated by\n",
        "# mojo-anything; regenerate with `mojo-anything refresh`.\n\n",
        'require "fiddle"\nrequire "json"\nrequire "rbconfig"\n',
        ruby_codec(),
        body,
    )


def wrapper(m: Manifest) -> String:
    """The wrapper: the same modules and module functions, each calling the
    Mojo library through `<lib>_native.rb`."""
    var lib = m.lib_name()
    var out = String(
        "# frozen_string_literal: true\n\n",
        "# The Mojo port of `",
        m.unit,
        "`, generated by mojo-anything: the same module functions, each\n",
        (
            "# calling the Mojo library. Load it in place of the original"
            " files. Regenerate with\n"
        ),
        "# `mojo-anything refresh`.\n\n",
        'require_relative "',
        lib,
        '_native"\n',
    )
    var recvs = List[String]()
    var groups = List[List[String]]()
    for f in m.exports:
        var rn = receiver(f)
        var args = List[String]()
        for p in f.params:
            args.append(p.name)
        var call_args = String("")
        if len(args) > 0:
            call_args = ", " + join(args, ", ")
        var d = String(
            "def self.",
            rn[1],
            "(",
            signature(f),
            ")\n  MojoAnythingNative",
            camel(lib),
            '.call("',
            f.name,
            '"',
            call_args,
            ")\nend",
        )
        var at = -1
        for i in range(len(recvs)):
            if recvs[i] == rn[0]:
                at = i
                break
        if at < 0:
            recvs.append(rn[0])
            var one = List[String]()
            one.append(d)
            groups.append(one^)
        else:
            groups[at].append(d)
    for g in range(len(recvs)):
        var parts = List[String]()
        for p in recvs[g].split("::"):
            parts.append(String(p))
        var code = String("")
        for depth in range(len(parts)):
            code += String(_indent(depth), "module ", parts[depth], "\n")
        var indent = _indent(len(parts))
        for i in range(len(groups[g])):
            if i > 0:
                code += "\n"
            for line in lines(groups[g][i]):
                code += String(indent, line, "\n")
        var depth = len(parts) - 1
        while depth >= 0:
            code += String(_indent(depth), "end\n")
            depth -= 1
        out += "\n" + code
    return out
