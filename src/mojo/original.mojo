# The original program behind the front door. Generated by mojo-anything; the
# front door calls `run` for every command no unit answers, and glue that read
# stdin and then declines a case calls `run_with_stdin`. Each call is one
# fallback, logged to $MOJO_ANYTHING_FALLBACK_LOG when it is set.
#
# The original starts through fork, execvp and waitpid: the stdlib's
# `subprocess.run` captures stdout and drops the exit status, and posix_spawn
# needs `environ`, which `external_call` cannot read. stdin and stdout are the
# front door's own file descriptors, so their bytes pass through untouched.
#
# On Linux the original ends with the front door: SIGTERM, SIGINT and SIGHUP
# sent to the front door are passed on to it (they are blocked and taken with
# sigtimedwait while it runs, as Mojo cannot install a signal handler), and it
# gets PR_SET_PDEATHSIG for a front door killed any other way.

from std.ffi import external_call
from std.memory import Pointer
from std.os import getenv
from std.os.path import exists, isfile
from std.sys import get_defined_string, stderr
from std.sys.info import CompilationTarget

comptime _Bytes = Pointer[UInt8, MutAnyOrigin]
comptime _CStrs = Pointer[Optional[_Bytes], MutAnyOrigin]
comptime _Ints = Pointer[Int32, MutAnyOrigin]
comptime _Longs = Pointer[Int, MutAnyOrigin]
comptime _SIGHUP = Int32(1)
comptime _SIGINT = Int32(2)
comptime _SIGPIPE = Int32(13)
comptime _SIGTERM = Int32(15)
comptime _SIG_DFL = Int(0)
comptime _SIG_IGN = Int(1)
comptime _SIG_BLOCK = Int32(0)
comptime _SIG_SETMASK = Int32(2)
comptime _PR_SET_PDEATHSIG = Int32(1)
comptime _WNOHANG = Int32(1)
comptime _EINTR = Int32(4)
comptime FALLBACK_LOG = "{{FALLBACK_ENV}}"
comptime REPO_ENV = "{{REPO_ENV}}"
comptime IN_ROOT = {{IN_ROOT}}


def _run_words() -> List[String]:
    """The command line that runs the original, as recorded."""
    return {{RUN}}


def _dirname(path: String) -> String:
    var bytes = path.as_bytes()
    var end = len(bytes)
    while end > 1 and bytes[end - 1] == 47:
        end -= 1
    while end > 0 and bytes[end - 1] != 47:
        end -= 1
    while end > 1 and bytes[end - 1] == 47:
        end -= 1
    if end == 0:
        return "."
    return String(path[byte=0:end])


def _beside_binary() -> String:
    """The repository from the binary's place, `mojo/app/.mojo-anything/build`.
    """
    var size = 4096
    var buf = _alloc(size)
    var link = _cstr("/proc/self/exe")
    # SAFETY: `link` is NUL-terminated and `buf` holds `size` writable bytes;
    # readlink writes at most that many and returns how many it wrote.
    var n = external_call["readlink", Int](link, buf, size)
    var out = String(".")
    if n > 0 and n < size:
        out = String(
            unsafe_from_utf8=Span[UInt8, ImmutAnyOrigin](
                unsafe_ptr=buf, length=n
            )
        )
        for _ in range(5):
            out = _dirname(out)
    _free(link)
    _free(buf)
    return out


def root() -> String:
    """The repository the original runs from: $MOJO_ANYTHING_REPO, then the one
    mojo-anything built the front door in, then the binary's location."""
    var repo = getenv(REPO_ENV)
    if repo.byte_length() > 0:
        return repo
    comptime built = get_defined_string[REPO_ENV, ""]()
    if built.byte_length() > 0:
        return built
    return _beside_binary()


def _resolve(word: String, repo: String) -> String:
    """A word of the recorded command that names a file in the repository, made
    absolute so the original runs from any working directory."""
    if word.startswith("-"):
        return word
    var path = repo + "/" + word
    var looks_like_path = word.find("/") >= 0 or isfile(path)
    if looks_like_path and exists(path):
        return path
    return word


def _log(args: List[String]):
    var path = getenv(FALLBACK_LOG)
    if path.byte_length() == 0:
        return
    try:
        var line = String()
        for i in range(len(args)):
            if i > 0:
                line += " "
            line += args[i]
        var log = open(path, "a")
        log.write(line + "\n")
        log.close()
    except:
        pass


def report_fallbacks():
    """Tells `mojo-anything app replay` this build counts its fallbacks, even
    when it makes none."""
    var path = getenv(FALLBACK_LOG)
    if path.byte_length() == 0:
        return
    try:
        var log = open(path, "a")
        log.close()
    except:
        pass


def _alloc(n: Int) -> _Bytes:
    # SAFETY: malloc returns `n` writable bytes; `value()` aborts on NULL.
    return external_call["malloc", Optional[_Bytes]](n).value()


def _free(p: _Bytes):
    # SAFETY: `p` came from `_alloc` and is freed once.
    external_call["free", NoneType](p)


def _cstr(s: String) -> _Bytes:
    """A NUL-terminated copy of `s` in C memory."""
    var bytes = s.as_bytes()
    var n = len(bytes)
    var p = _alloc(n + 1)
    for i in range(n):
        p[unsafe_offset=i] = bytes[i]
    p[unsafe_offset=n] = 0
    return p


def _exit_status(status: Int) -> Int:
    """The front door's own exit for the original's wait status: the same exit
    code, or the same signal raised on the front door itself."""
    var signal = status & 0x7F
    if signal == 0:
        return (status >> 8) & 0xFF
    # SAFETY: restores the default action for `signal`, then raises it on this
    # process, which ends here as the original did.
    _ = external_call["signal", Int](Int32(signal), _SIG_DFL)
    # SAFETY: `raise(3)` takes a signal number and touches no memory.
    _ = external_call["raise", Int32](Int32(signal))
    return 128 + signal


def _errno() -> Int32:
    comptime if CompilationTarget.is_linux():
        # SAFETY: glibc's errno of this thread, always a valid int.
        return external_call["__errno_location", _Ints]()[]
    else:
        # SAFETY: the C library's errno of this thread, always a valid int.
        return external_call["__error", _Ints]()[]


def _forwarded() -> _Bytes:
    """The signals passed on to the original, as a `sigset_t` (128 bytes)."""
    var set = _alloc(128)
    comptime if CompilationTarget.is_linux():
        # SAFETY: `set` holds 128 writable bytes, glibc's sigset_t.
        _ = external_call["sigemptyset", Int32](set)
        # SAFETY: `set` is an initialised sigset_t; 1 is SIGHUP.
        _ = external_call["sigaddset", Int32](set, _SIGHUP)
        # SAFETY: `set` is an initialised sigset_t; 2 is SIGINT.
        _ = external_call["sigaddset", Int32](set, _SIGINT)
        # SAFETY: `set` is an initialised sigset_t; 15 is SIGTERM.
        _ = external_call["sigaddset", Int32](set, _SIGTERM)
    return set


def _set_mask(how: Int32, set: _Bytes, old: Optional[_Bytes]):
    comptime if CompilationTarget.is_linux():
        # SAFETY: `set` holds a sigset_t, and `old`, when given, 128 writable
        # bytes for the mask before the call.
        _ = external_call["sigprocmask", Int32](how, set, old)


def _wait(pid: Int32, status: _Ints, forwarded: _Bytes) -> Bool:
    """Waits for the original; True once its wait status is in `status`, False
    when waitpid fails. On Linux a forwarded signal sent to the front door
    meanwhile (blocked, so taken here) goes on to the original."""
    comptime if CompilationTarget.is_linux():
        # SAFETY: room for a `siginfo_t` (128 bytes); `value()` aborts on NULL.
        var info = external_call["malloc", Optional[_Ints]](128).value()
        # SAFETY: room for a `struct timespec`; `value()` aborts on NULL.
        var ts = external_call["malloc", Optional[_Longs]](16).value()
        ts[unsafe_offset=0] = 0
        ts[unsafe_offset=1] = 50_000_000
        var done = False
        while True:
            # SAFETY: `status` points at a writable int; WNOHANG never blocks.
            var got = external_call["waitpid", Int32](pid, status, _WNOHANG)
            if got == pid:
                done = True
                break
            if got < 0:
                if _errno() == _EINTR:
                    continue
                break
            # SAFETY: `forwarded` holds a sigset_t, `info` room for a siginfo_t
            # and `ts` a timespec of 50 ms.
            var sig = external_call["sigtimedwait", Int32](forwarded, info, ts)
            # si_code (the third int) is 0 or less when a process sent the
            # signal; a terminal's ^C reaches the original's process group
            # itself and is not sent twice.
            if sig > 0 and info[unsafe_offset=2] <= 0:
                # SAFETY: kill(2) takes a process id and a signal number.
                _ = external_call["kill", Int32](pid, sig)
        # SAFETY: `info` came from malloc above and is freed once.
        external_call["free", NoneType](info)
        # SAFETY: `ts` came from malloc above and is freed once.
        external_call["free", NoneType](ts)
        return done
    else:
        while True:
            # SAFETY: `status` points at a writable int.
            var got = external_call["waitpid", Int32](pid, status, Int32(0))
            if got == pid:
                return True
            if got < 0 and _errno() != _EINTR:
                return False


def _spawn(args: List[String], input: Optional[List[UInt8]]) -> Int:
    var repo = root()
    var words = _run_words()
    var argv = List[String]()
    for i in range(len(words)):
        argv.append(_resolve(words[i], repo))
    for i in range(len(args)):
        argv.append(args[i])
    var n = len(argv)
    # SAFETY: room for `n` pointers and the NULL that ends execvp's argv.
    var cargv = external_call["malloc", Optional[_CStrs]]((n + 1) * 8).value()
    for i in range(n):
        cargv[unsafe_offset=i] = _cstr(argv[i])
    cargv[unsafe_offset=n] = None
    var croot = _cstr(repo)
    # SAFETY: two ints for pipe(2); `value()` aborts on NULL.
    var fds = external_call["malloc", Optional[_Ints]](8).value()
    fds[unsafe_offset=0] = -1
    fds[unsafe_offset=1] = -1
    if input:
        # SAFETY: `fds` points at two writable ints.
        _ = external_call["pipe", Int32](fds)
    var forwarded = _forwarded()
    var saved = _alloc(128)
    _set_mask(_SIG_BLOCK, forwarded, saved)
    # SAFETY: getpid(2) takes no arguments.
    var parent = external_call["getpid", Int32]()
    print("", end="", flush=True)
    # SAFETY: fork(2) takes no arguments. The child below only calls
    # sigprocmask, prctl, getppid, dup2, close, chdir, execvp, perror and _exit.
    var pid = external_call["fork", Int32]()
    if pid == 0:
        _set_mask(_SIG_SETMASK, saved, None)
        comptime if CompilationTarget.is_linux():
            # SAFETY: asks the kernel to send SIGTERM when the front door ends.
            _ = external_call["prctl", Int32](_PR_SET_PDEATHSIG, _SIGTERM)
            # SAFETY: getppid(2) takes no arguments. A front door gone before
            # the prctl above would never send the signal.
            if external_call["getppid", Int32]() != parent:
                # SAFETY: leaves the child without running any cleanup.
                external_call["_exit", NoneType](Int32(1))
        if input:
            # SAFETY: plain file descriptor calls on the pipe's two ends.
            _ = external_call["dup2", Int32](fds[unsafe_offset=0], Int32(0))
            # SAFETY: closes the read end, now duplicated onto stdin.
            _ = external_call["close", Int32](fds[unsafe_offset=0])
            # SAFETY: closes the write end, which only the front door uses.
            _ = external_call["close", Int32](fds[unsafe_offset=1])
        comptime if IN_ROOT:
            # SAFETY: `croot` is NUL-terminated.
            _ = external_call["chdir", Int32](croot)
        # SAFETY: `cargv` holds `n` NUL-terminated strings and ends with NULL.
        _ = external_call["execvp", Int32](
            cargv[unsafe_offset=0].value(), cargv
        )
        var what = _cstr("front door: cannot run the original")
        # SAFETY: `what` is NUL-terminated; perror prints it and errno.
        external_call["perror", NoneType](what)
        # SAFETY: leaves the child without running the front door's cleanup.
        external_call["_exit", NoneType](Int32(127))
    for i in range(n):
        _free(cargv[unsafe_offset=i].value())
    # SAFETY: `cargv` came from malloc above.
    external_call["free", NoneType](cargv)
    _free(croot)
    if pid < 0:
        _set_mask(_SIG_SETMASK, saved, None)
        _free(saved)
        _free(forwarded)
        # SAFETY: `fds` came from malloc above.
        external_call["free", NoneType](fds)
        print("front door: cannot start the original", file=stderr)
        return 127
    if input:
        # SAFETY: closes the read end, which the child holds.
        _ = external_call["close", Int32](fds[unsafe_offset=0])
        var data = input.value().copy()
        var m = len(data)
        var buf = _alloc(m + 1)
        for i in range(m):
            buf[unsafe_offset=i] = data[i]
        # SAFETY: ignores SIGPIPE while writing, so an original that stops
        # reading its stdin does not end the front door.
        _ = external_call["signal", Int](_SIGPIPE, _SIG_IGN)
        var done = 0
        while done < m:
            # SAFETY: `buf` holds `m` bytes, `done` of them written already.
            var wrote = external_call["write", Int](
                fds[unsafe_offset=1], buf.unsafe_offset(done), m - done
            )
            if wrote <= 0:
                break
            done += wrote
        # SAFETY: closes the write end: the original reads end of file.
        _ = external_call["close", Int32](fds[unsafe_offset=1])
        # SAFETY: restores the default action for SIGPIPE.
        _ = external_call["signal", Int](_SIGPIPE, _SIG_DFL)
        _free(buf)
    # SAFETY: `fds` came from malloc above.
    external_call["free", NoneType](fds)
    # SAFETY: one int for waitpid's status; `value()` aborts on NULL.
    var status = external_call["malloc", Optional[_Ints]](4).value()
    status[] = 0
    var waited = _wait(pid, status, forwarded)
    var errno = _errno()
    _set_mask(_SIG_SETMASK, saved, None)
    _free(saved)
    _free(forwarded)
    var code = Int(status[])
    # SAFETY: `status` came from malloc above.
    external_call["free", NoneType](status)
    if not waited:
        print(
            String(
                "front door: cannot wait for the original (errno ",
                errno,
                "); its exit status is lost",
            ),
            file=stderr,
        )
        return 125
    return _exit_status(code)


def run(args: List[String]) -> Int:
    """Runs the original with the same arguments, stdin and environment; its
    output passes through, and its exit status is returned (a signal that ended
    it ends the front door too). Each call is one fallback."""
    _log(args)
    return _spawn(args, None)


def run_with_stdin(args: List[String], input: List[UInt8]) -> Int:
    """For glue that read stdin and then declines the case: runs the original
    with `input` as its stdin. Each call is one fallback."""
    _log(args)
    return _spawn(args, input.copy())
