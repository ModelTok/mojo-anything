# HTTP/1.1 for the server front door, on the C library's sockets. Generated by
# mojo-anything: requests and responses as bytes (bodies are never decoded on
# the way through), keep-alive, chunked bodies, and TCP_NODELAY on every socket
# so a response never waits for a delayed ACK. It listens on 127.0.0.1 and ::1
# (Node 17 and later resolve `localhost` to ::1), and refuses a request body
# larger than $MOJO_ANYTHING_MAX_BODY bytes (16 MiB by default) with 413
# before reading it. The constants are {{OS}}'s.

from std.ffi import external_call
from std.memory import Pointer
from std.os import abort, getenv
from std.sys.info import CompilationTarget
from std.time import perf_counter_ns

comptime _Bytes = Pointer[UInt8, MutAnyOrigin]
comptime _Ints = Pointer[Int32, MutAnyOrigin]
comptime _Longs = Pointer[Int, MutAnyOrigin]
comptime _AF_INET = Int32(2)
comptime _AF_INET6 = Int32({{AF_INET6}})
comptime _SOCK_STREAM = Int32(1)
comptime _SOL_SOCKET = Int32({{SOL_SOCKET}})
comptime _SO_REUSEADDR = Int32({{SO_REUSEADDR}})
comptime _SO_RCVTIMEO = Int32({{SO_RCVTIMEO}})
comptime _TIMEVAL_SIZE = Int32({{TIMEVAL_SIZE}})
#[macos]
comptime _SO_NOSIGPIPE = Int32(0x1022)
#[end]
comptime IDLE_SECONDS = 5
comptime _IPPROTO_TCP = Int32(6)
comptime _TCP_NODELAY = Int32(1)
comptime _IPPROTO_IPV6 = Int32(41)
comptime _IPV6_V6ONLY = Int32({{IPV6_V6ONLY}})
comptime _MSG_NOSIGNAL = Int32({{MSG_NOSIGNAL}})
comptime _POLLIN = Int32(1)
comptime _SHUT_WR = Int32(1)
comptime _CHUNK = 65536
comptime TEXT = "text/plain; charset=utf-8"
comptime MAX_BODY_ENV = "MOJO_ANYTHING_MAX_BODY"
comptime MAX_BODY = 16 * 1024 * 1024
comptime _TOO_LARGE = "413 "


def check_target():
    """Stops a front door built on another system than the one it was generated
    for: its socket constants are that system's."""
    comptime if not CompilationTarget.is_{{OS}}():
        abort(
            "this server was generated for {{OS}}: run `mojo-anything app"
            " front-door` again on this machine"
        )


def max_body() -> Int:
    """The largest request body read: $MOJO_ANYTHING_MAX_BODY, or 16 MiB."""
    var given = getenv(MAX_BODY_ENV)
    if given.byte_length() > 0:
        try:
            return Int(given)
        except:
            pass
    return MAX_BODY


def too_large(e: Error) -> Bool:
    """Whether `read_request` refused a body larger than `max_body()`."""
    return String(e).startswith(_TOO_LARGE)


def _refuse_body(n: Int, limit: Int) raises:
    raise Error(
        String(
            _TOO_LARGE,
            "the request body has ",
            n,
            " bytes, more than ",
            MAX_BODY_ENV,
            " allows (",
            limit,
            ")",
        )
    )


@fieldwise_init
struct Header(Copyable, Movable):
    var name: String
    var value: String


def _lower(text: String) -> String:
    return text.lower()


def _find_header(headers: List[Header], name: String) -> Optional[String]:
    var wanted = _lower(name)
    for i in range(len(headers)):
        if _lower(headers[i].name) == wanted:
            return headers[i].value
    return None


def to_bytes(text: String) -> List[UInt8]:
    var out = List[UInt8](capacity=text.byte_length())
    for b in text.as_bytes():
        out.append(b)
    return out^


struct Request(Copyable, Movable):
    """A request as the client sent it; the body is the bytes after any chunked
    encoding is undone."""

    var method: String
    var target: String
    var version: String
    var headers: List[Header]
    var body: List[UInt8]

    def __init__(out self, method: String, target: String):
        self.method = method
        self.target = target
        self.version = "HTTP/1.1"
        self.headers = List[Header]()
        self.body = List[UInt8]()

    def path(self) -> String:
        """The target without its query."""
        var q = self.target.find("?")
        if q < 0:
            return self.target
        return String(self.target[byte=0:q])

    def query(self) -> String:
        var q = self.target.find("?")
        if q < 0:
            return ""
        return String(self.target[byte = q + 1 : self.target.byte_length()])

    def header(self, name: String) -> Optional[String]:
        return _find_header(self.headers, name)

    def text(self) -> String:
        """The body as text; bytes that are not UTF-8 become U+FFFD."""
        return String(from_utf8_lossy=Span(self.body))

    def keep_alive(self) -> Bool:
        var connection = self.header("connection")
        var value = _lower(connection.value()) if connection else String()
        if self.version == "HTTP/1.0":
            return value == "keep-alive"
        return value != "close"


def reason(status: Int) -> String:
    if status == 200:
        return "OK"
    if status == 201:
        return "Created"
    if status == 204:
        return "No Content"
    if status == 301:
        return "Moved Permanently"
    if status == 302:
        return "Found"
    if status == 304:
        return "Not Modified"
    if status == 400:
        return "Bad Request"
    if status == 401:
        return "Unauthorized"
    if status == 403:
        return "Forbidden"
    if status == 404:
        return "Not Found"
    if status == 405:
        return "Method Not Allowed"
    if status == 409:
        return "Conflict"
    if status == 413:
        return "Content Too Large"
    if status == 422:
        return "Unprocessable Entity"
    if status == 500:
        return "Internal Server Error"
    if status == 502:
        return "Bad Gateway"
    if status == 503:
        return "Service Unavailable"
    return "Status"


struct Response(Copyable, Movable):
    """A response: status, headers in order, body bytes. `Content-Length` is
    written from the body."""

    var status: Int
    var reason: String
    var headers: List[Header]
    var body: List[UInt8]

    def __init__(out self, status: Int):
        self.status = status
        self.reason = reason(status)
        self.headers = List[Header]()
        self.body = List[UInt8]()

    def __init__(out self, status: Int, content_type: String, body: String):
        self.status = status
        self.reason = reason(status)
        self.headers = List[Header]()
        self.headers.append(Header("Content-Type", content_type))
        self.body = to_bytes(body)

    def header(self, name: String) -> Optional[String]:
        return _find_header(self.headers, name)

    def set_header(mut self, name: String, value: String):
        var wanted = _lower(name)
        for i in range(len(self.headers)):
            if _lower(self.headers[i].name) == wanted:
                self.headers[i].value = value
                return
        self.headers.append(Header(name, value))


def text(status: Int, body: String) -> Response:
    """A `text/plain; charset=utf-8` response."""
    return Response(status, TEXT, body)


def _alloc(n: Int) -> _Bytes:
    # SAFETY: malloc returns `n` writable bytes; `value()` aborts on NULL.
    return external_call["malloc", Optional[_Bytes]](n).value()


def _free(p: _Bytes):
    # SAFETY: `p` came from `_alloc` and is freed once.
    external_call["free", NoneType](p)


def _set_int(fd: Int32, level: Int32, option: Int32, value: Int32):
    # SAFETY: one int for the option value; `value()` aborts on NULL.
    var v = external_call["malloc", Optional[_Ints]](4).value()
    v[] = value
    # SAFETY: `v` points at one int, and setsockopt reads that many bytes.
    _ = external_call["setsockopt", Int32](fd, level, option, v, Int32(4))
    # SAFETY: `v` came from malloc above.
    external_call["free", NoneType](v)


def _sockaddr(port: Int, loopback: Bool) -> _Bytes:
    """A `struct sockaddr_in` (16 bytes) for `port` on 127.0.0.1 or any
    address."""
    var a = _alloc(16)
    for i in range(16):
        a[unsafe_offset=i] = 0
#[linux]
    a[unsafe_offset=0] = UInt8(2)
#[macos]
    a[unsafe_offset=0] = UInt8(16)
    a[unsafe_offset=1] = UInt8(2)
#[end]
    a[unsafe_offset=2] = UInt8((port >> 8) & 0xFF)
    a[unsafe_offset=3] = UInt8(port & 0xFF)
    if loopback:
        a[unsafe_offset=4] = 127
        a[unsafe_offset=7] = 1
    return a


def _sockaddr6(port: Int, loopback: Bool) -> _Bytes:
    """A `struct sockaddr_in6` (28 bytes) for `port` on ::1 or any address."""
    var a = _alloc(28)
    for i in range(28):
        a[unsafe_offset=i] = 0
#[linux]
    a[unsafe_offset=0] = UInt8(10)
#[macos]
    a[unsafe_offset=0] = UInt8(28)
    a[unsafe_offset=1] = UInt8(30)
#[end]
    a[unsafe_offset=2] = UInt8((port >> 8) & 0xFF)
    a[unsafe_offset=3] = UInt8(port & 0xFF)
    if loopback:
        a[unsafe_offset=23] = 1
    return a


def close(fd: Int32):
    # SAFETY: closes a descriptor this module opened.
    _ = external_call["close", Int32](fd)


def listen(port: Int, loopback: Bool = True) raises -> Int32:
    """A listening socket on `port` (0: any free port), on 127.0.0.1 unless
    `loopback` is False (every address)."""
    # SAFETY: socket(2) takes three ints.
    var fd = external_call["socket", Int32](_AF_INET, _SOCK_STREAM, Int32(0))
    if fd < 0:
        raise Error("cannot open a socket")
    _set_int(fd, _SOL_SOCKET, _SO_REUSEADDR, 1)
    var addr = _sockaddr(port, loopback)
    # SAFETY: `addr` holds a 16-byte sockaddr_in.
    var bound = external_call["bind", Int32](fd, addr, Int32(16))
    _free(addr)
    if bound != 0:
        close(fd)
        raise Error(String("cannot bind port ", port))
    # SAFETY: plain call on the socket opened above.
    if external_call["listen", Int32](fd, Int32(512)) != 0:
        close(fd)
        raise Error(String("cannot listen on port ", port))
    return fd


def _listen6(port: Int, loopback: Bool) -> Int32:
    """A listening IPv6 socket on `port` (::1, or every address), IPv6 only;
    -1 when the machine has no IPv6 there."""
    # SAFETY: socket(2) takes three ints.
    var fd = external_call["socket", Int32](_AF_INET6, _SOCK_STREAM, Int32(0))
    if fd < 0:
        return -1
    _set_int(fd, _SOL_SOCKET, _SO_REUSEADDR, 1)
    _set_int(fd, _IPPROTO_IPV6, _IPV6_V6ONLY, 1)
    var addr = _sockaddr6(port, loopback)
    # SAFETY: `addr` holds a 28-byte sockaddr_in6.
    var bound = external_call["bind", Int32](fd, addr, Int32(28))
    _free(addr)
    if bound != 0:
        close(fd)
        return -1
    # SAFETY: plain call on the socket opened above.
    if external_call["listen", Int32](fd, Int32(512)) != 0:
        close(fd)
        return -1
    return fd


@fieldwise_init
struct Listeners(Copyable, Movable):
    """The server's sockets: IPv4, and IPv6 (-1 when there is none)."""

    var v4: Int32
    var v6: Int32


def listen_all(port: Int, loopback: Bool = True) raises -> Listeners:
    """Listening sockets on `port` for 127.0.0.1 and ::1, or for every address
    of both families when `loopback` is False. IPv6 is left out where the
    machine has none."""
    check_target()
    var v4 = listen(port, loopback)
    return Listeners(v4, _listen6(local_port(v4), loopback))


def local_port(fd: Int32) -> Int:
    """The port a socket is bound to."""
    var addr = _alloc(16)
    # SAFETY: one int for the address size; `value()` aborts on NULL.
    var size = external_call["malloc", Optional[_Ints]](4).value()
    size[] = 16
    # SAFETY: `addr` holds 16 writable bytes and `size` says so.
    _ = external_call["getsockname", Int32](fd, addr, size)
    var port = (Int(addr[unsafe_offset=2]) << 8) | Int(addr[unsafe_offset=3])
    _free(addr)
    # SAFETY: `size` came from malloc above.
    external_call["free", NoneType](size)
    return port


def free_port() raises -> Int:
    """A port nothing listens on now, for the original."""
    var fd = listen(0, True)
    var port = local_port(fd)
    close(fd)
    return port


def _set_read_timeout(fd: Int32, seconds: Int):
    # SAFETY: room for a `struct timeval` (two longs); `value()` aborts on NULL.
    var tv = external_call["malloc", Optional[_Longs]](16).value()
    tv[unsafe_offset=0] = seconds
    tv[unsafe_offset=1] = 0
    # SAFETY: `tv` holds one `struct timeval`, and setsockopt reads 16 bytes.
    _ = external_call["setsockopt", Int32](
        fd, _SOL_SOCKET, _SO_RCVTIMEO, tv, _TIMEVAL_SIZE
    )
    # SAFETY: `tv` came from malloc above.
    external_call["free", NoneType](tv)


def _ready(listeners: Listeners, timeout_ms: Int) -> Int32:
    """The listener with a client waiting within `timeout_ms`: -2 when none
    came, -1 when poll failed."""
    # SAFETY: room for two `struct pollfd`; `value()` aborts on NULL.
    var fds = external_call["malloc", Optional[_Ints]](16).value()
    fds[unsafe_offset=0] = listeners.v4
    fds[unsafe_offset=1] = _POLLIN
    fds[unsafe_offset=2] = listeners.v6
    fds[unsafe_offset=3] = _POLLIN
    # SAFETY: `fds` holds two `struct pollfd` (int fd; short events, revents);
    # poll skips the entry of a missing IPv6 socket (-1).
    var n = external_call["poll", Int32](fds, Int(2), Int32(timeout_ms))
    var which = Int32(-1)
    if n == 0:
        which = -2
    elif n > 0 and (fds[unsafe_offset=1] >> 16) != 0:
        which = listeners.v4
    elif n > 0 and (fds[unsafe_offset=3] >> 16) != 0:
        which = listeners.v6
    # SAFETY: `fds` came from malloc above.
    external_call["free", NoneType](fds)
    return which


def accept(listeners: Listeners, timeout_ms: Int) -> Int32:
    """The next connection on either listener, with TCP_NODELAY set and reads
    that give up after IDLE_SECONDS, so a client that sends nothing never holds
    the next one up; -2 when none came within `timeout_ms`, -1 when accept
    failed."""
    var listener = _ready(listeners, timeout_ms)
    if listener < 0:
        return listener
    # SAFETY: NULL address arguments: the peer's address is not wanted.
    var fd = external_call["accept", Int32](
        listener, Optional[_Bytes](None), Optional[_Ints](None)
    )
    if fd >= 0:
        _set_int(fd, _IPPROTO_TCP, _TCP_NODELAY, 1)
#[macos]
        _set_int(fd, _SOL_SOCKET, _SO_NOSIGPIPE, 1)
#[end]
        _set_read_timeout(fd, IDLE_SECONDS)
    return fd


def connect(port: Int) -> Int32:
    """A connection to 127.0.0.1:`port` with TCP_NODELAY set; -1 when nothing
    listens there."""
    # SAFETY: socket(2) takes three ints.
    var fd = external_call["socket", Int32](_AF_INET, _SOCK_STREAM, Int32(0))
    if fd < 0:
        return -1
    var addr = _sockaddr(port, True)
    # SAFETY: `addr` holds a 16-byte sockaddr_in.
    var ok = external_call["connect", Int32](fd, addr, Int32(16))
    _free(addr)
    if ok != 0:
        close(fd)
        return -1
    _set_int(fd, _IPPROTO_TCP, _TCP_NODELAY, 1)
#[macos]
    _set_int(fd, _SOL_SOCKET, _SO_NOSIGPIPE, 1)
#[end]
    return fd


def wait_readable(fd: Int32, listeners: Listeners, timeout_ms: Int) -> Bool:
    """Whether `fd` has bytes (or its end of file) before `timeout_ms`; False as
    soon as a listener has a client waiting while `fd` is idle, so an idle
    keep-alive connection never holds the next client up."""
    # SAFETY: room for three `struct pollfd`; `value()` aborts on NULL.
    var fds = external_call["malloc", Optional[_Ints]](24).value()
    fds[unsafe_offset=0] = fd
    fds[unsafe_offset=1] = _POLLIN
    fds[unsafe_offset=2] = listeners.v4
    fds[unsafe_offset=3] = _POLLIN
    fds[unsafe_offset=4] = listeners.v6
    fds[unsafe_offset=5] = _POLLIN
    # SAFETY: `fds` holds three `struct pollfd` (int fd; short events,
    # revents); poll skips a missing IPv6 socket (-1).
    var n = external_call["poll", Int32](fds, Int(3), Int32(timeout_ms))
    var ready = n > 0 and (fds[unsafe_offset=1] >> 16) != 0
    # SAFETY: `fds` came from malloc above.
    external_call["free", NoneType](fds)
    return ready


def send_all(fd: Int32, data: List[UInt8]) -> Bool:
    var n = len(data)
    var buf = _alloc(n + 1)
    for i in range(n):
        buf[unsafe_offset=i] = data[i]
    var done = 0
    while done < n:
        # SAFETY: `buf` holds `n` bytes, `done` of them sent already;
        # MSG_NOSIGNAL turns a closed peer into an error, not SIGPIPE.
        var sent = external_call["send", Int](
            fd, buf.unsafe_offset(done), n - done, _MSG_NOSIGNAL
        )
        if sent <= 0:
            break
        done += sent
    _free(buf)
    return done == n


def close_after_refusal(fd: Int32):
    """Closes a connection whose request was refused before its body was read:
    the write side first, then what the client still sends is read and dropped
    for up to two seconds, so the refusal is not lost to a reset."""
    # SAFETY: shutdown(2) on a socket this module accepted.
    _ = external_call["shutdown", Int32](fd, _SHUT_WR)
    _set_read_timeout(fd, 1)
    var tmp = _alloc(_CHUNK)
    var deadline = perf_counter_ns() + 2_000_000_000
    while perf_counter_ns() < deadline:
        # SAFETY: `tmp` holds `_CHUNK` writable bytes; recv writes at most that.
        if external_call["recv", Int](fd, tmp, _CHUNK, Int32(0)) <= 0:
            break
    _free(tmp)
    close(fd)


struct Conn(Movable):
    """One end of a connection, with what was read and not used yet."""

    var fd: Int32
    var buf: List[UInt8]
    var pos: Int

    def __init__(out self, fd: Int32):
        self.fd = fd
        self.buf = List[UInt8]()
        self.pos = 0

    def available(self) -> Int:
        return len(self.buf) - self.pos

    def fill(mut self) -> Bool:
        """Reads more bytes; False at end of file or on an error."""
        if self.pos > 0:
            var rest = List[UInt8](capacity=self.available() + _CHUNK)
            for i in range(self.pos, len(self.buf)):
                rest.append(self.buf[i])
            self.buf = rest^
            self.pos = 0
        var tmp = _alloc(_CHUNK)
        # SAFETY: `tmp` holds `_CHUNK` writable bytes; recv writes at most that.
        var n = external_call["recv", Int](self.fd, tmp, _CHUNK, Int32(0))
        for i in range(n):
            self.buf.append(tmp[unsafe_offset=i])
        _free(tmp)
        return n > 0

    def find(self, a: UInt8, b: UInt8, c: UInt8, d: UInt8) -> Int:
        """Where the 4 bytes start after `pos`, or -1."""
        var i = self.pos
        while i + 3 < len(self.buf):
            if (
                self.buf[i] == a
                and self.buf[i + 1] == b
                and self.buf[i + 2] == c
                and self.buf[i + 3] == d
            ):
                return i
            i += 1
        return -1

    def find_crlf(self) -> Int:
        var i = self.pos
        while i + 1 < len(self.buf):
            if self.buf[i] == 13 and self.buf[i + 1] == 10:
                return i
            i += 1
        return -1

    def take(mut self, n: Int) -> List[UInt8]:
        var out = List[UInt8](capacity=n)
        for i in range(self.pos, self.pos + n):
            out.append(self.buf[i])
        self.pos += n
        return out^

    def text(mut self, n: Int) -> String:
        var bytes = self.take(n)
        return String(from_utf8_lossy=Span(bytes))

    def head(mut self) raises -> Optional[String]:
        """The head (start line and headers) up to the blank line; None at end
        of file before any byte."""
        var start_size = self.available()
        while True:
            var end = self.find(13, 10, 13, 10)
            if end >= 0:
                var head = self.text(end - self.pos)
                self.pos += 4
                return head
            if self.available() > 1 << 20:
                raise Error("the head is larger than 1 MiB")
            if not self.fill():
                if self.available() == 0 and start_size == 0:
                    return None
                raise Error("the connection closed in the middle of a head")

    def exactly(mut self, n: Int) raises -> List[UInt8]:
        while self.available() < n:
            if not self.fill():
                raise Error("the connection closed in the middle of a body")
        return self.take(n)

    def line(mut self) raises -> String:
        while True:
            var end = self.find_crlf()
            if end >= 0:
                var line = self.text(end - self.pos)
                self.pos += 2
                return line
            if not self.fill():
                raise Error("the connection closed in the middle of a chunk")

    def chunked(mut self, limit: Int) raises -> List[UInt8]:
        """A chunked body; `limit` bytes at most (-1: no limit)."""
        var body = List[UInt8]()
        while True:
            var size_line = self.line()
            var size = _hex(size_line)
            if limit >= 0 and len(body) + size > limit:
                _refuse_body(len(body) + size, limit)
            if size == 0:
                while self.line().byte_length() > 0:
                    pass
                return body^
            var chunk = self.exactly(size)
            for b in chunk:
                body.append(b)
            if self.line().byte_length() != 0:
                raise Error("a chunk does not end with CRLF")

    def rest(mut self) -> List[UInt8]:
        while self.fill():
            pass
        return self.take(self.available())


def _hex(line: String) raises -> Int:
    var n = 0
    var digits = 0
    for b in line.as_bytes():
        var v: Int
        if b >= 48 and b <= 57:
            v = Int(b) - 48
        elif b >= 97 and b <= 102:
            v = Int(b) - 87
        elif b >= 65 and b <= 70:
            v = Int(b) - 55
        elif b == 59 or b == 32 or b == 9:
            break
        else:
            raise Error(String("bad chunk size `", line, "`"))
        n = n * 16 + v
        digits += 1
        if digits > 15:
            raise Error("chunk size is too large")
    if digits == 0:
        raise Error(String("bad chunk size `", line, "`"))
    return n


def _headers(lines: List[String]) raises -> List[Header]:
    var out = List[Header]()
    for i in range(1, len(lines)):
        var line = lines[i]
        var colon = line.find(":")
        if colon <= 0:
            raise Error(String("bad header line `", line, "`"))
        var name = String(line[byte=0:colon])
        var value = String(line[byte = colon + 1 : line.byte_length()])
        out.append(Header(name, String(value.strip())))
    return out^


def _lines(head: String) -> List[String]:
    var out = List[String]()
    for part in head.split("\r\n"):
        out.append(String(part))
    return out^


def _body(
    mut conn: Conn, headers: List[Header], limit: Int
) raises -> List[UInt8]:
    """A body framed by `Transfer-Encoding: chunked` or `Content-Length`; empty
    without either (a request). Larger than `limit` (-1: no limit) is refused
    before it is read."""
    var encoding = _find_header(headers, "transfer-encoding")
    if encoding and "chunked" in _lower(encoding.value()):
        return conn.chunked(limit)
    var length = _find_header(headers, "content-length")
    if length:
        var n = Int(String(length.value().strip()))
        if n < 0:
            raise Error("a negative Content-Length")
        if limit >= 0 and n > limit:
            _refuse_body(n, limit)
        return conn.exactly(n)
    return List[UInt8]()


def read_request(mut conn: Conn) raises -> Optional[Request]:
    """The next request on the connection, or None when the client closed it."""
    var head = conn.head()
    if not head:
        return None
    var lines = _lines(head.value())
    var parts = lines[0].split(" ")
    if len(parts) != 3:
        raise Error(String("bad request line `", lines[0], "`"))
    var req = Request(String(parts[0]), String(parts[1]))
    req.version = String(parts[2])
    req.headers = _headers(lines)
    var limit = max_body()
    var length = req.header("content-length")
    if length:
        var n = Int(String(length.value().strip()))
        if n > limit:
            _refuse_body(n, limit)
    var expect = req.header("expect")
    if expect and _lower(expect.value()) == "100-continue":
        # The client waits for this before it sends the body.
        _ = send_all(conn.fd, to_bytes("HTTP/1.1 100 Continue\r\n\r\n"))
    req.body = _body(conn, req.headers, limit)
    return req^


def _put(mut out: List[UInt8], text: String):
    for b in text.as_bytes():
        out.append(b)


def _framing(name: String) -> Bool:
    """Headers the front door writes itself for each hop."""
    var n = _lower(name)
    return (
        n == "connection"
        or n == "keep-alive"
        or n == "transfer-encoding"
        or n == "content-length"
        or n == "proxy-connection"
    )


def write_response(
    fd: Int32, resp: Response, head_only: Bool, keep_alive: Bool
) -> Bool:
    """Writes `resp` with its `Content-Length`; a response to HEAD keeps the
    length its headers give and has no body."""
    var out = List[UInt8](capacity=len(resp.body) + 256)
    _put(out, String("HTTP/1.1 ", resp.status, " ", resp.reason, "\r\n"))
    for i in range(len(resp.headers)):
        if not _framing(resp.headers[i].name):
            _put(
                out,
                resp.headers[i].name + ": " + resp.headers[i].value + "\r\n",
            )
    var bodiless = resp.status < 200 or resp.status == 204 or resp.status == 304
    if head_only:
        var length = resp.header("content-length")
        if length:
            _put(out, "Content-Length: " + length.value() + "\r\n")
    elif not bodiless:
        _put(out, String("Content-Length: ", len(resp.body), "\r\n"))
    if not keep_alive:
        _put(out, "Connection: close\r\n")
    _put(out, "\r\n")
    if not head_only and not bodiless:
        for b in resp.body:
            out.append(b)
    return send_all(fd, out)


def forward(port: Int, req: Request) raises -> Response:
    """Sends `req` to the server on 127.0.0.1:`port` and reads its answer."""
    var fd = connect(port)
    if fd < 0:
        raise Error(String("nothing listens on port ", port))
    var out = List[UInt8](capacity=len(req.body) + 512)
    _put(out, req.method + " " + req.target + " HTTP/1.1\r\n")
    _put(out, String("Host: 127.0.0.1:", port, "\r\n"))
    for i in range(len(req.headers)):
        var name = req.headers[i].name
        if _framing(name) or _lower(name) == "host" or _lower(name) == "expect":
            continue
        _put(out, name + ": " + req.headers[i].value + "\r\n")
    var sent_length = req.header("content-length") or req.header(
        "transfer-encoding"
    )
    if (
        len(req.body) > 0
        or sent_length
        or req.method == "POST"
        or req.method == "PUT"
        or req.method == "PATCH"
    ):
        _put(out, String("Content-Length: ", len(req.body), "\r\n"))
    _put(out, "Connection: close\r\n\r\n")
    for b in req.body:
        out.append(b)
    if not send_all(fd, out):
        close(fd)
        raise Error("the original closed the connection")
    var conn = Conn(fd)
    var resp = Response(0)
    while True:
        var head = conn.head()
        if not head:
            close(fd)
            raise Error("the original closed the connection without answering")
        var lines = _lines(head.value())
        var parts = lines[0].split(" ", 2)
        if len(parts) < 2:
            close(fd)
            raise Error(String("bad status line `", lines[0], "`"))
        resp.status = Int(String(parts[1]))
        resp.reason = String(parts[2]) if len(parts) > 2 else String()
        resp.headers = _headers(lines)
        if resp.status >= 200 or resp.status == 101:
            break
    var bodiless = (
        req.method == "HEAD"
        or resp.status < 200
        or resp.status == 204
        or resp.status == 304
    )
    if not bodiless:
        var encoding = resp.header("transfer-encoding")
        if (encoding and "chunked" in _lower(encoding.value())) or resp.header(
            "content-length"
        ):
            resp.body = _body(conn, resp.headers, -1)
        else:
            resp.body = conn.rest()
    close(fd)
    var kept = List[Header]()
    for i in range(len(resp.headers)):
        var name = _lower(resp.headers[i].name)
        if req.method == "HEAD" and name == "content-length":
            kept.append(resp.headers[i].copy())
        elif not _framing(name):
            kept.append(resp.headers[i].copy())
    resp.headers = kept^
    return resp^


def _segments(path: String) -> List[String]:
    var out = List[String]()
    var start = 1 if path.startswith("/") else 0
    var trimmed = String(path[byte = start : path.byte_length()])
    for part in trimmed.split("/"):
        out.append(String(part))
    return out^


def matches(route: String, path: String) -> Bool:
    """Whether `path` matches `route` (`/users/{id}`, `/files/{*rest}`): a
    parameter takes one non-empty segment, a `{*rest}` the non-empty rest."""
    var want = _segments(route)
    var have = _segments(path)
    for i in range(len(want)):
        var part = want[i]
        if part.startswith("{*"):
            return i < len(have) and have[i].byte_length() > 0
        if i >= len(have):
            return False
        if part.startswith("{") and part.endswith("}"):
            if have[i].byte_length() == 0:
                return False
        elif part != have[i]:
            return False
    return len(want) == len(have)


def _hex_digit(b: UInt8) -> Int:
    if b >= 48 and b <= 57:
        return Int(b) - 48
    if b >= 97 and b <= 102:
        return Int(b) - 87
    if b >= 65 and b <= 70:
        return Int(b) - 55
    return -1


def percent_decode(text: String) -> String:
    """`%XX` escapes decoded; text whose escapes are not UTF-8 stays as sent."""
    var bytes = text.as_bytes()
    var out = List[UInt8](capacity=len(bytes))
    var i = 0
    while i < len(bytes):
        if bytes[i] == 37 and i + 2 < len(bytes):
            var high = _hex_digit(bytes[i + 1])
            var low = _hex_digit(bytes[i + 2])
            if high >= 0 and low >= 0:
                out.append(UInt8(high * 16 + low))
                i += 3
                continue
        out.append(bytes[i])
        i += 1
    try:
        return String(from_utf8=Span(out))
    except:
        return text


def path_params(route: String, path: String) -> Dict[String, String]:
    """The parameters of `route` in `path`, percent-decoded."""
    var out = Dict[String, String]()
    var want = _segments(route)
    var have = _segments(path)
    for i in range(len(want)):
        var part = want[i]
        if part.startswith("{*") and part.endswith("}"):
            var name = String(part[byte = 2 : part.byte_length() - 1])
            var rest = String()
            for j in range(i, len(have)):
                if j > i:
                    rest += "/"
                rest += have[j]
            out[name] = percent_decode(rest)
            return out^
        if part.startswith("{") and part.endswith("}") and i < len(have):
            var name = String(part[byte = 1 : part.byte_length() - 1])
            out[name] = percent_decode(have[i])
    return out^
