# The original server behind the front door. Generated by mojo-anything for
# {{OS}}: `start` runs it on a free port of its own, and `proxy` sends it every
# request no unit answers (glue that declines a request calls it too). Each
# proxied request is one fallback, logged to $MOJO_ANYTHING_FALLBACK_LOG when it
# is set.
#
# The original starts through fork and execvp (see the CLI front door).
#[linux]
# It gets PR_SET_PDEATHSIG, so it ends when the front door ends, however that
# happens.
#[macos]
# macOS has no PR_SET_PDEATHSIG: `start` blocks SIGTERM, SIGINT and SIGHUP,
# and `idle` (called by the accept loop at least once a second) passes a
# pending one on to the original and then ends the front door with it. An
# original whose front door is killed with SIGKILL keeps running.
#[end]

from std.ffi import external_call
from std.memory import Pointer
from std.os import getenv, setenv, unsetenv
from std.os.path import exists, isfile
from std.sys import get_defined_string
from std.time import perf_counter_ns

import http

comptime _Bytes = Pointer[UInt8, MutAnyOrigin]
comptime _CStrs = Pointer[Optional[_Bytes], MutAnyOrigin]
comptime _Ints = Pointer[Int32, MutAnyOrigin]
#[linux]
comptime _PR_SET_PDEATHSIG = Int32(1)
comptime _SIGTERM = Int(15)
#[macos]
comptime _SIGHUP = Int32(1)
comptime _SIGINT = Int32(2)
comptime _SIGTERM = Int32(15)
comptime _SIG_DFL = Int(0)
comptime _SIG_BLOCK = Int32(1)
comptime _SIG_UNBLOCK = Int32(2)
comptime _SIG_SETMASK = Int32(3)
comptime PID_ENV = "MOJO_ANYTHING_ORIGINAL_PID"
#[end]
comptime _WNOHANG = Int32(1)
comptime FALLBACK_LOG = "{{FALLBACK_ENV}}"
comptime REPO_ENV = "{{REPO_ENV}}"
comptime PORT_ENV = "MOJO_ANYTHING_ORIGINAL_PORT"
comptime IN_ROOT = {{IN_ROOT}}


def _run_words() -> List[String]:
    """The command line that runs the original, as recorded."""
    return {{RUN}}


def _repo_files() -> List[String]:
    """The words of the command that named files in the repository."""
    return {{REPO_FILES}}


def _launch_args() -> List[String]:
    """The arguments every start was recorded with, after the command; `{port}`
    is the original's own port."""
    return {{ARGS}}


def _dirname(path: String) -> String:
    var bytes = path.as_bytes()
    var end = len(bytes)
    while end > 1 and bytes[end - 1] == 47:
        end -= 1
    while end > 0 and bytes[end - 1] != 47:
        end -= 1
    while end > 1 and bytes[end - 1] == 47:
        end -= 1
    if end == 0:
        return "."
    return String(path[byte=0:end])


def _alloc(n: Int) -> _Bytes:
    # SAFETY: malloc returns `n` writable bytes; `value()` aborts on NULL.
    return external_call["malloc", Optional[_Bytes]](n).value()


def _free(p: _Bytes):
    # SAFETY: `p` came from `_alloc` and is freed once.
    external_call["free", NoneType](p)


def _cstr(s: String) -> _Bytes:
    """A NUL-terminated copy of `s` in C memory."""
    var bytes = s.as_bytes()
    var n = len(bytes)
    var p = _alloc(n + 1)
    for i in range(n):
        p[unsafe_offset=i] = bytes[i]
    p[unsafe_offset=n] = 0
    return p


def _beside_binary() -> String:
    """The repository from the binary's place, `mojo/app/.mojo-anything/build`.
    """
    var size = 4096
    var buf = _alloc(size)
    var out = String(".")
#[linux]
    var link = _cstr("/proc/self/exe")
    # SAFETY: `link` is NUL-terminated and `buf` holds `size` writable bytes;
    # readlink writes at most that many and returns how many it wrote.
    var n = external_call["readlink", Int](link, buf, size)
    _free(link)
#[macos]
    var exe = _alloc(size)
    # SAFETY: one uint32_t for the buffer size; `value()` aborts on NULL.
    var room = external_call["malloc", Optional[_Ints]](4).value()
    room[] = Int32(size)
    var n = -1
    # SAFETY: `exe` holds `room[]` writable bytes; the call writes the path
    # with its NUL and returns 0, or -1 when it does not fit.
    if external_call["_NSGetExecutablePath", Int32](exe, room) == 0:
        # SAFETY: `exe` is NUL-terminated and `buf` holds 4096 bytes, more
        # than PATH_MAX (1024); realpath returns `buf` or NULL.
        var real = external_call["realpath", Optional[_Bytes]](exe, buf)
        if real:
            n = 0
            while n < size and buf[unsafe_offset=n] != 0:
                n += 1
    # SAFETY: `room` came from malloc above and is freed once.
    external_call["free", NoneType](room)
    _free(exe)
#[end]
    if n > 0 and n < size:
        out = String(
            unsafe_from_utf8=Span[UInt8, ImmutAnyOrigin](
                unsafe_ptr=buf, length=n
            )
        )
        for _ in range(5):
            out = _dirname(out)
    _free(buf)
    return out


def root() -> String:
    """The repository the original runs from: $MOJO_ANYTHING_REPO, then the one
    mojo-anything built the front door in, then the binary's location."""
    var repo = getenv(REPO_ENV)
    if repo.byte_length() > 0:
        return repo
    comptime built = get_defined_string[REPO_ENV, ""]()
    if built.byte_length() > 0:
        return built
    return _beside_binary()


def _resolve(word: String, repo: String, port: Int) raises -> String:
    """A word of the recorded command with `{port}` filled in; one that names
    a file in the repository is made absolute. Raises when a word that named a
    file there names none: `repo` is not the repository."""
    var filled = word.replace("{port}", String(port))
    if filled.startswith("-"):
        return filled
    var path = repo + "/" + filled
    var looks_like_path = filled.find("/") >= 0 or isfile(path)
    if looks_like_path and exists(path):
        return path
    if word in _repo_files():
        raise Error(
            String(
                path,
                " does not exist, so ",
                repo,
                " is not the repository the original was recorded in (",
                REPO_ENV,
                " names it when set)",
            )
        )
    return filled


def report_fallbacks():
    """Tells `mojo-anything app replay` this build counts its fallbacks, even
    when it makes none."""
    var path = getenv(FALLBACK_LOG)
    if path.byte_length() == 0:
        return
    try:
        var log = open(path, "a")
        log.close()
    except:
        pass


def _append(path: String, req: http.Request):
    if path.byte_length() == 0:
        return
    try:
        var log = open(path, "a")
        log.write(req.method + " " + req.target + "\n")
        log.close()
    except:
        pass


def _log(req: http.Request):
    _append(getenv(FALLBACK_LOG), req)


def served(req: http.Request):
    """Tells `mojo-anything app replay` the front door itself read `req`, so a
    replay that reached another process on the port fails."""
    var path = getenv(FALLBACK_LOG)
    if path.byte_length() > 0:
        _append(path + ".served", req)


def _exited(pid: Int32) -> Bool:
    # SAFETY: one int for waitpid's status; `value()` aborts on NULL.
    var status = external_call["malloc", Optional[_Ints]](4).value()
    # SAFETY: `status` points at a writable int; WNOHANG never blocks.
    var got = external_call["waitpid", Int32](pid, status, _WNOHANG)
    # SAFETY: `status` came from malloc above.
    external_call["free", NoneType](status)
    return got == pid
#[macos]


def _forwarded() -> _Bytes:
    """SIGTERM, SIGINT and SIGHUP as a `sigset_t` (128 bytes of room)."""
    var set = _alloc(128)
    # SAFETY: `set` holds 128 writable bytes, room for a sigset_t.
    _ = external_call["sigemptyset", Int32](set)
    # SAFETY: `set` is an initialised sigset_t; 1 is SIGHUP.
    _ = external_call["sigaddset", Int32](set, _SIGHUP)
    # SAFETY: `set` is an initialised sigset_t; 2 is SIGINT.
    _ = external_call["sigaddset", Int32](set, _SIGINT)
    # SAFETY: `set` is an initialised sigset_t; 15 is SIGTERM.
    _ = external_call["sigaddset", Int32](set, _SIGTERM)
    return set
#[end]


def idle():
    """Called by the accept loop when no client came for a while."""
#[linux]
    # The kernel ends the original with the front door (PR_SET_PDEATHSIG).
    pass
#[macos]
    var pending = _alloc(128)
    # SAFETY: `pending` holds 128 writable bytes, room for a sigset_t.
    _ = external_call["sigpending", Int32](pending)
    var sig = Int32(0)
    for s in [_SIGHUP, _SIGINT, _SIGTERM]:
        # SAFETY: `pending` holds the sigset_t sigpending wrote.
        if external_call["sigismember", Int32](pending, s) == 1:
            sig = s
    _free(pending)
    if sig == 0:
        return
    var pid = getenv(PID_ENV)
    if pid.byte_length() > 0:
        try:
            var child = Int32(Int(pid))
            # SAFETY: kill(2) takes a process id and a signal number.
            _ = external_call["kill", Int32](child, sig)
            # SAFETY: one int for waitpid's status; `value()` aborts on NULL.
            var status = external_call["malloc", Optional[_Ints]](4).value()
            # SAFETY: `status` points at a writable int; waits for the
            # original to end.
            _ = external_call["waitpid", Int32](child, status, Int32(0))
            # SAFETY: `status` came from malloc above.
            external_call["free", NoneType](status)
        except:
            pass
    # SAFETY: restores the default action, so the pending signal ends the
    # front door once it is unblocked below.
    _ = external_call["signal", Int](sig, _SIG_DFL)
    var set = _forwarded()
    # SAFETY: `set` holds a sigset_t; unblocking delivers the pending signal.
    _ = external_call["sigprocmask", Int32](_SIG_UNBLOCK, set, Optional[_Bytes](None))
    _free(set)
#[end]


def start() raises:
    """Starts the original on a free port with the recorded arguments and waits
    until it listens; `proxy` finds it through $MOJO_ANYTHING_ORIGINAL_PORT. The
    front door's own arguments never reach the original: they carry the public
    port, which is the front door's."""
    http.check_target()
    var repo = root()
    var port = http.free_port()
    var words = _run_words()
    var argv_ = List[String]()
    for i in range(len(words)):
        argv_.append(_resolve(words[i], repo, port))
    var args = _launch_args()
    for i in range(len(args)):
        argv_.append(args[i].replace("{port}", String(port)))
    var n = len(argv_)
    # SAFETY: room for `n` pointers and the NULL that ends execvp's argv.
    var cargv = external_call["malloc", Optional[_CStrs]]((n + 1) * 8).value()
    for i in range(n):
        cargv[unsafe_offset=i] = _cstr(argv_[i])
    cargv[unsafe_offset=n] = None
    var croot = _cstr(repo)
    var failed = "front door: cannot run the original\n"
    var what = _cstr(failed)
#[linux]
    var devnull = _cstr("/dev/null")
#[macos]
    # The original's stdin: a pipe whose write end is closed, so it reads end
    # of file at once, as from /dev/null (`open` is declared by the stdlib with
    # another signature, and macOS has no `open64`).
    # SAFETY: two ints for pipe(2); `value()` aborts on NULL.
    var nothing = external_call["malloc", Optional[_Ints]](8).value()
    nothing[unsafe_offset=0] = -1
    nothing[unsafe_offset=1] = -1
    # SAFETY: `nothing` points at two writable ints.
    _ = external_call["pipe", Int32](nothing)
    var forwarded = _forwarded()
    var saved = _alloc(128)
    # SAFETY: `forwarded` holds a sigset_t and `saved` room for the old mask;
    # the signals stay blocked in the front door, where `idle` takes them.
    _ = external_call["sigprocmask", Int32](_SIG_BLOCK, forwarded, Optional[_Bytes](saved))
#[end]
    var own_port = getenv("PORT")
    var log = getenv(FALLBACK_LOG)
    _ = setenv("PORT", String(port))
    _ = unsetenv(FALLBACK_LOG)
    print("", end="", flush=True)
    # SAFETY: fork(2) takes no arguments. The child below calls only
    # async-signal-safe functions on memory allocated before the fork:
    # the process-death or signal-mask call, opening the empty input, dup2,
    # close, chdir, execvp, write and _exit.
    var pid = external_call["fork", Int32]()
    if pid == 0:
#[linux]
        # SAFETY: asks the kernel to send SIGTERM when the front door ends.
        _ = external_call["prctl", Int32](_PR_SET_PDEATHSIG, _SIGTERM)
        # SAFETY: `devnull` is NUL-terminated; O_RDONLY is 0. (`open` is
        # declared by the stdlib with another signature, so glibc's `open64`.)
        var null = external_call["open64", Int32](devnull, Int32(0))
#[macos]
        # SAFETY: `saved` holds the mask from before `start` blocked signals.
        _ = external_call["sigprocmask", Int32](
            _SIG_SETMASK, saved, Optional[_Bytes](None)
        )
        # SAFETY: closes the pipe's write end: the read end sees end of file.
        _ = external_call["close", Int32](nothing[unsafe_offset=1])
        var null = nothing[unsafe_offset=0]
#[end]
        if null >= 0:
            # SAFETY: plain file descriptor calls: the empty input becomes
            # stdin.
            _ = external_call["dup2", Int32](null, Int32(0))
            # SAFETY: closes the descriptor just duplicated onto stdin.
            _ = external_call["close", Int32](null)
        comptime if IN_ROOT:
            # SAFETY: `croot` is NUL-terminated.
            _ = external_call["chdir", Int32](croot)
        # SAFETY: `cargv` holds `n` NUL-terminated strings and ends with NULL.
        _ = external_call["execvp", Int32](
            cargv[unsafe_offset=0].value(), cargv
        )
        # SAFETY: `what` holds the message's bytes, written before the fork.
        _ = external_call["write", Int](
            Int32(2), what, failed.byte_length()
        )
        # SAFETY: leaves the child without running the front door's cleanup.
        external_call["_exit", NoneType](Int32(127))
    if own_port.byte_length() > 0:
        _ = setenv("PORT", own_port)
    else:
        _ = unsetenv("PORT")
    if log.byte_length() > 0:
        _ = setenv(FALLBACK_LOG, log)
    for i in range(n):
        _free(cargv[unsafe_offset=i].value())
    # SAFETY: `cargv` came from malloc above.
    external_call["free", NoneType](cargv)
    _free(croot)
    _free(what)
#[linux]
    _free(devnull)
#[macos]
    # SAFETY: the pipe's ends belong to the child now.
    _ = external_call["close", Int32](nothing[unsafe_offset=0])
    # SAFETY: closes the write end the child closed too.
    _ = external_call["close", Int32](nothing[unsafe_offset=1])
    # SAFETY: `nothing` came from malloc above.
    external_call["free", NoneType](nothing)
    _free(saved)
    _free(forwarded)
    _ = setenv(PID_ENV, String(pid))
#[end]
    if pid < 0:
        raise Error("cannot start the original")
    var deadline = perf_counter_ns() + 60_000_000_000
    while True:
        var fd = http.connect(port)
        if fd >= 0:
            http.close(fd)
            break
        if _exited(pid):
            raise Error(
                String("the original exited before listening on port ", port)
            )
        if perf_counter_ns() > deadline:
            raise Error(String("the original did not listen on port ", port))
        # SAFETY: usleep takes a number of microseconds.
        _ = external_call["usleep", Int32](UInt32(50_000))
    _ = setenv(PORT_ENV, String(port))


def proxy(req: http.Request) -> http.Response:
    """Sends the request to the original and passes its answer through. Each
    call is one fallback."""
    _log(req)
    try:
        return http.forward(Int(getenv(PORT_ENV)), req)
    except e:
        return http.text(
            502, String("front door: the original did not answer: ", e, "\n")
        )
