{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ModelTok/mojo-anything",
  "title": "mojo-anything",
  "description": "Rewrite an app in Mojo one piece at a time, checked against the original's recorded behaviour.",
  "repository": {
    "url": "https://github.com/ModelTok/mojo-anything",
    "source": "github"
  },
  "websiteUrl": "https://github.com/ModelTok/mojo-anything",
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
