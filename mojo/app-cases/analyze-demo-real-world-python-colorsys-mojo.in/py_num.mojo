# A Python number in a Mojo port, generated by mojo-anything.
#
# `PyNum` keeps Python's semantics: an `int` stays an `int` and a `float` a `float`, ints are
# unbounded, `-0.0`, NaN and infinities survive, and errors carry Python's exception type.
# Floats and ints that fit in 62 bits are computed natively; anything else (big ints, bools,
# division by zero, `**`) is handed to Python itself, so the result is exactly Python's.

from std.math import trunc
from std.python import Python, PythonObject

comptime _FLOAT = 0
comptime _INT = 1
comptime _OBJ = 2
# Ints this small cannot overflow an `Int` when added or subtracted, and convert to `Float64`
# exactly when they are at most 2**53.
comptime _SMALL = 1 << 62
comptime _EXACT = 1 << 53

comptime _HELPER_NAME = "_mojo_anything_py_num"
comptime _HELPER = """
import operator

_OPS = {
    "add": operator.add, "sub": operator.sub, "mul": operator.mul,
    "truediv": operator.truediv, "floordiv": operator.floordiv, "mod": operator.mod,
    "pow": operator.pow, "neg": operator.neg, "abs": abs, "int": int, "float": float,
    "lt": operator.lt, "le": operator.le, "gt": operator.gt, "ge": operator.ge,
    "eq": operator.eq, "ne": operator.ne,
}


def call(name, *args):
    try:
        return (True, _OPS[name](*args))
    except BaseException as e:
        return (False, f"{type(e).__name__}: {e}")
"""


def _helper() raises -> PythonObject:
    var modules = Python.import_module("sys").modules
    if Bool(modules.__contains__(_HELPER_NAME)):
        var module = modules[_HELPER_NAME]
        if Bool(Python.import_module("builtins").hasattr(module, "call")):
            return module
    return Python.evaluate(_HELPER, file=True, name=_HELPER_NAME)


def _py(name: String, a: PythonObject) raises -> PythonObject:
    var r = _helper().call(name, a)
    if not Bool(r[0]):
        raise Error(String(py=r[1]))
    return r[1]


def _py(name: String, a: PythonObject, b: PythonObject) raises -> PythonObject:
    var r = _helper().call(name, a, b)
    if not Bool(r[0]):
        raise Error(String(py=r[1]))
    return r[1]


def _py_mod_float(a: Float64, b: Float64) -> Float64:
    """Python's float `%`: the result takes the divisor's sign; `b` is not zero."""
    from std.ffi import external_call

    # SAFETY: libm's fmod is a pure function of two doubles.
    var m = external_call["fmod", Float64](a, b)
    if m != 0.0:
        if (m < 0.0) != (b < 0.0):
            m += b
    else:
        m = 0.0 if b > 0.0 else -0.0
    return m


struct PyNum(Copyable, Movable, Writable):
    """A Python `int` or `float` with Python's arithmetic."""

    var _kind: Int
    var _f: Float64
    var _i: Int
    var _obj: PythonObject

    @implicit
    def __init__(out self, value: Float64):
        self._kind = _FLOAT
        self._f = value
        self._i = 0
        self._obj = PythonObject(None)

    @implicit
    def __init__(out self, value: Int):
        self._kind = _INT
        self._f = 0.0
        self._i = value
        self._obj = PythonObject(None)
        if value >= _SMALL or value <= -_SMALL:
            self._kind = _OBJ
            self._obj = PythonObject(value)

    def __init__(out self, *, py: PythonObject) raises:
        """A Python value; anything but a plain `int` or `float` stays a Python object."""
        var builtins = Python.import_module("builtins")
        var t = Python.type(py)
        self._f = 0.0
        self._i = 0
        self._obj = PythonObject(None)
        if t is builtins.float:
            self._kind = _FLOAT
            self._f = Float64(py=py)
        elif t is builtins.int and Bool(py < _SMALL) and Bool(py > -_SMALL):
            self._kind = _INT
            self._i = Int(py=py)
        else:
            self._kind = _OBJ
            self._obj = py

    def to_python(self) raises -> PythonObject:
        if self._kind == _FLOAT:
            return PythonObject(self._f)
        if self._kind == _INT:
            return PythonObject(self._i)
        return self._obj

    def is_float(self) -> Bool:
        return self._kind == _FLOAT

    def is_int(self) -> Bool:
        return self._kind == _INT

    def write_to(self, mut writer: Some[Writer]):
        if self._kind == _FLOAT:
            writer.write(self._f)
        elif self._kind == _INT:
            writer.write(self._i)
        else:
            writer.write("<python number>")

    # Both sides as floats, when Python would compute in floats exactly as Float64 does.
    def _floats(self, other: Self) -> Optional[Tuple[Float64, Float64]]:
        if self._kind == _OBJ or other._kind == _OBJ:
            return None
        if self._kind == _INT and other._kind == _INT:
            return None
        var a = self._f if self._kind == _FLOAT else Float64(self._i)
        var b = other._f if other._kind == _FLOAT else Float64(other._i)
        if self._kind == _INT and (self._i > _EXACT or self._i < -_EXACT):
            return None
        if other._kind == _INT and (other._i > _EXACT or other._i < -_EXACT):
            return None
        return (a, b)

    def _ints(self, other: Self) -> Bool:
        return self._kind == _INT and other._kind == _INT

    def _slow(self, name: String, other: Self) raises -> Self:
        return Self(py=_py(name, self.to_python(), other.to_python()))

    def __add__(self, other: Self) raises -> Self:
        if self._ints(other):
            return Self(self._i + other._i)
        var f = self._floats(other)
        if f:
            return Self(f.value()[0] + f.value()[1])
        return self._slow("add", other)

    def __sub__(self, other: Self) raises -> Self:
        if self._ints(other):
            return Self(self._i - other._i)
        var f = self._floats(other)
        if f:
            return Self(f.value()[0] - f.value()[1])
        return self._slow("sub", other)

    def __mul__(self, other: Self) raises -> Self:
        if self._ints(other):
            # Factors under 2**31 cannot overflow; larger ones go to Python.
            if abs(self._i) < (1 << 31) and abs(other._i) < (1 << 31):
                return Self(self._i * other._i)
            return self._slow("mul", other)
        var f = self._floats(other)
        if f:
            return Self(f.value()[0] * f.value()[1])
        return self._slow("mul", other)

    def __truediv__(self, other: Self) raises -> Self:
        if self._ints(other):
            if other._i != 0 and self._i <= _EXACT and self._i >= -_EXACT and other._i <= _EXACT and other._i >= -_EXACT:
                return Self(Float64(self._i) / Float64(other._i))
            return self._slow("truediv", other)
        var f = self._floats(other)
        if f and f.value()[1] != 0.0:
            return Self(f.value()[0] / f.value()[1])
        return self._slow("truediv", other)

    def __floordiv__(self, other: Self) raises -> Self:
        if self._ints(other) and other._i != 0:
            return Self(self._i // other._i)
        return self._slow("floordiv", other)

    def __mod__(self, other: Self) raises -> Self:
        if self._ints(other) and other._i != 0:
            return Self(self._i % other._i)
        var f = self._floats(other)
        if f and f.value()[1] != 0.0:
            return Self(_py_mod_float(f.value()[0], f.value()[1]))
        return self._slow("mod", other)

    def __pow__(self, other: Self) raises -> Self:
        return self._slow("pow", other)

    def __neg__(self) raises -> Self:
        if self._kind == _FLOAT:
            return Self(-self._f)
        if self._kind == _INT:
            return Self(-self._i)
        return Self(py=_py("neg", self._obj))

    def _compare(self, name: String, other: Self) raises -> Bool:
        return Bool(_py(name, self.to_python(), other.to_python()))

    def __lt__(self, other: Self) raises -> Bool:
        if self._ints(other):
            return self._i < other._i
        var f = self._floats(other)
        if f:
            return f.value()[0] < f.value()[1]
        return self._compare("lt", other)

    def __le__(self, other: Self) raises -> Bool:
        if self._ints(other):
            return self._i <= other._i
        var f = self._floats(other)
        if f:
            return f.value()[0] <= f.value()[1]
        return self._compare("le", other)

    def __gt__(self, other: Self) raises -> Bool:
        return other.__lt__(self)

    def __ge__(self, other: Self) raises -> Bool:
        return other.__le__(self)

    def __eq__(self, other: Self) raises -> Bool:
        if self._ints(other):
            return self._i == other._i
        var f = self._floats(other)
        if f:
            return f.value()[0] == f.value()[1]
        return self._compare("eq", other)

    def __ne__(self, other: Self) raises -> Bool:
        return not self.__eq__(other)


def py_int(x: PyNum) raises -> PyNum:
    """Python's `int(x)`: truncates a float; NaN and infinities raise as Python does."""
    if x._kind == _INT:
        return x.copy()
    if x._kind == _FLOAT and x._f == x._f and x._f < 1.0e15 and x._f > -1.0e15:
        return PyNum(Int(trunc(x._f)))
    return PyNum(py=_py("int", x.to_python()))


def py_float(x: PyNum) raises -> PyNum:
    """Python's `float(x)`."""
    if x._kind == _FLOAT:
        return x.copy()
    if x._kind == _INT and x._i <= _EXACT and x._i >= -_EXACT:
        return PyNum(Float64(x._i))
    return PyNum(py=_py("float", x.to_python()))


def py_abs(x: PyNum) raises -> PyNum:
    if x._kind == _FLOAT:
        return PyNum(abs(x._f))
    if x._kind == _INT:
        return PyNum(abs(x._i))
    return PyNum(py=_py("abs", x._obj))


def py_max(a: PyNum, b: PyNum) raises -> PyNum:
    """Python's `max(a, b)`: the first of equal values wins."""
    return b.copy() if b > a else a.copy()


def py_max(a: PyNum, b: PyNum, c: PyNum) raises -> PyNum:
    return py_max(py_max(a, b), c)


def py_min(a: PyNum, b: PyNum) raises -> PyNum:
    """Python's `min(a, b)`: the first of equal values wins."""
    return b.copy() if b < a else a.copy()


def py_min(a: PyNum, b: PyNum, c: PyNum) raises -> PyNum:
    return py_min(py_min(a, b), c)
