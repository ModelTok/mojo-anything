# The JSON dispatcher for the Mojo port of `src/floats.ts`, generated by mojo-anything. Regenerate
# with `mojo-anything refresh`.

from std.ffi import external_call
from std.memory import Pointer

from emberjson import Array, Object
from json import JsonValue, as_float, json_array, json_bool, json_float, json_int, json_string, json_uint, parse_json, write_json

import port


def _undefined() raises -> JsonValue:
    # JS's `undefined`, as the TS codec carries it.
    var o = Object()
    o["$undefined"] = JsonValue(True)
    return JsonValue(o^)

def _bytes_text(p: Optional[Pointer[Int8, ImmutAnyOrigin]]) -> String:
    # SAFETY: the caller passes NULL or a NUL-terminated string valid for the call. The bytes
    # are UTF-8 JSON; they are copied as they are.
    if not p:
        return String()
    var ptr = p.value().unsafe_bitcast[UInt8]()
    var n = 0
    while ptr[unsafe_offset=n] != 0:
        n += 1
    return String(
        unsafe_from_utf8=Span[UInt8, ImmutAnyOrigin](unsafe_ptr=ptr, length=n)
    )


def _answer(s: String) -> Optional[Pointer[Int8, MutAnyOrigin]]:
    var b = s.as_bytes()
    var n = len(b)
    var p = external_call["malloc", Optional[Pointer[UInt8, MutAnyOrigin]]](n + 1)
    if not p:
        return None
    var q = p.value()
    for i in range(n):
        q[unsafe_offset=i] = b[i]
    q[unsafe_offset=n] = 0
    return q.unsafe_bitcast[Int8]()


def _tagged(tag: String, message: String) -> String:
    var o = Object()
    o[tag] = JsonValue(message)
    try:
        return write_json(JsonValue(o^))
    except:
        return '{"panic":"the dispatcher could not write its answer"}'


def _panic(message: String) -> String:
    return _tagged("panic", message)


def _error(message: String) -> String:
    return _tagged("error", message)


def _ok(v: JsonValue) -> String:
    try:
        return '{"ok":' + write_json(v) + "}"
    except e:
        return _panic("the result does not write as JSON: " + String(e))


def _to_json_Float64(v: Float64) raises -> JsonValue:
    return json_float(v)


def _from_json_Float64(v: JsonValue) raises -> Float64:
    return as_float(v)


def _from_json_List_Float64(v: JsonValue) raises -> List[Float64]:
    json_array(v)
    var items = List[Float64]()
    for item in v.array():
        items.append(_from_json_Float64(item))
    return items^


def _to_json_List_Float64(v: List[Float64]) raises -> JsonValue:
    var items = Array()
    for item in v:
        items.append(_to_json_Float64(item))
    return JsonValue(items^)


def _from_json_String(v: JsonValue) raises -> String:
    return json_string(v)


def _to_json_String(v: String) raises -> JsonValue:
    return JsonValue(String(v))


def _call_third(args: Array) -> String:
    if len(args) != 0:
        return _panic("third takes 0 arguments, got " + String(len(args)))
    try:
        var out = _to_json_Float64(port.third())
        return _ok(out)
    except e:
        return _error(String(e))


def _call_neg_zero(args: Array) -> String:
    if len(args) != 0:
        return _panic("negZero takes 0 arguments, got " + String(len(args)))
    try:
        var out = _to_json_Float64(port.neg_zero())
        return _ok(out)
    except e:
        return _error(String(e))


def _call_tiny(args: Array) -> String:
    if len(args) != 0:
        return _panic("tiny takes 0 arguments, got " + String(len(args)))
    try:
        var out = _to_json_Float64(port.tiny())
        return _ok(out)
    except e:
        return _error(String(e))


def _call_huge(args: Array) -> String:
    if len(args) != 0:
        return _panic("huge takes 0 arguments, got " + String(len(args)))
    try:
        var out = _to_json_Float64(port.huge())
        return _ok(out)
    except e:
        return _error(String(e))


def _call_sum(args: Array) -> String:
    if len(args) != 2:
        return _panic("sum takes 2 arguments, got " + String(len(args)))
    var a0: Float64
    var a1: Float64
    try:
        a0 = _from_json_Float64(args[0])
        a1 = _from_json_Float64(args[1])
    except e:
        return _panic("sum: " + String(e))
    try:
        var out = _to_json_Float64(port.sum(a0, a1))
        return _ok(out)
    except e:
        return _error(String(e))


def _call_echo_all(args: Array) -> String:
    if len(args) != 1:
        return _panic("echoAll takes 1 argument, got " + String(len(args)))
    var a0: List[Float64]
    try:
        a0 = _from_json_List_Float64(args[0])
    except e:
        return _panic("echoAll: " + String(e))
    try:
        var out = _to_json_List_Float64(port.echo_all(a0))
        return _ok(out)
    except e:
        return _error(String(e))


def _call_same(args: Array) -> String:
    if len(args) != 1:
        return _panic("same takes 1 argument, got " + String(len(args)))
    var a0: String
    try:
        a0 = _from_json_String(args[0])
    except e:
        return _panic("same: " + String(e))
    try:
        var out = _to_json_String(port.same(a0))
        return _ok(out)
    except e:
        return _error(String(e))


def _call(name: String, text: String) -> String:
    var args: JsonValue
    try:
        args = parse_json(text, False)
    except e:
        return _panic("the arguments are not JSON: " + String(e))
    if not args.is_array():
        return _panic("the arguments are not a JSON array")
    ref a = args.array()
    if name == "third":
        return _call_third(a)
    if name == "negZero":
        return _call_neg_zero(a)
    if name == "tiny":
        return _call_tiny(a)
    if name == "huge":
        return _call_huge(a)
    if name == "sum":
        return _call_sum(a)
    if name == "echoAll":
        return _call_echo_all(a)
    if name == "same":
        return _call_same(a)
    return _panic("unknown function: " + name)


@export
def mojo_anything_call(
    name: Optional[Pointer[Int8, ImmutAnyOrigin]],
    args: Optional[Pointer[Int8, ImmutAnyOrigin]],
) abi("C") -> Optional[Pointer[Int8, MutAnyOrigin]]:
    return _answer(_call(_bytes_text(name), _bytes_text(args)))


@export
def mojo_anything_free(p: Optional[Pointer[Int8, MutAnyOrigin]]) abi("C"):
    if p:
        external_call["free", NoneType](p.value())
