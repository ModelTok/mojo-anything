# Python bindings for the Mojo port of `src/mathkit/`, generated by mojo-anything from the
# signatures in `port.mojo`. Regenerate with `mojo-anything refresh` after changing them.

from std.os import abort

from std.python import Python, PythonObject
from std.python.bindings import PythonModuleBuilder

import port
from py_num import PyNum


@export
def PyInit__native() abi("C") -> PythonObject:
    try:
        var module = PythonModuleBuilder("_native")
        module.def_function[_bind_scale]("scale")
        module.def_function[_bind_safe_div]("safe_div")
        module.def_function[_bind_exclaim]("exclaim")
        module.def_function[_bind_count_items]("count_items")
        return module.finalize()
    except e:
        abort(String("failed to create the Python module: ", e))


def _bind_scale(p_x: PythonObject, p_factor: PythonObject) raises -> PythonObject:
    var a_x: PyNum
    try:
        a_x = _from_py_PyNum(p_x)
    except e:
        raise Error(String("TypeError: ", e))
    var a_factor: PyNum
    try:
        a_factor = _from_py_PyNum(p_factor)
    except e:
        raise Error(String("TypeError: ", e))
    return _to_py_PyNum(port.scale(a_x, a_factor))


def _bind_safe_div(p_a: PythonObject, p_b: PythonObject) raises -> PythonObject:
    var a_a: PyNum
    try:
        a_a = _from_py_PyNum(p_a)
    except e:
        raise Error(String("TypeError: ", e))
    var a_b: PyNum
    try:
        a_b = _from_py_PyNum(p_b)
    except e:
        raise Error(String("TypeError: ", e))
    return _to_py_PyNum(port.safe_div(a_a, a_b))


def _bind_exclaim(p_text: PythonObject) raises -> PythonObject:
    var a_text: String
    try:
        a_text = _from_py_String(p_text)
    except e:
        raise Error(String("TypeError: ", e))
    return _to_py_String(port.exclaim(a_text))


def _bind_count_items(p_items: PythonObject) raises -> PythonObject:
    var a_items: List[String]
    try:
        a_items = _from_py_List_String(p_items)
    except e:
        raise Error(String("TypeError: ", e))
    return _to_py_PyNum(port.count_items(a_items))


def _from_py_PyNum(v: PythonObject) raises -> PyNum:
    var b = Python.import_module("builtins")
    if not b.isinstance(v, Python.tuple(b.int, b.float)):
        raise Error(String("expected a number, got ", b.type(v).__name__))
    return PyNum(py=v)


def _to_py_PyNum(v: PyNum) raises -> PythonObject:
    return v.to_python()


def _from_py_String(v: PythonObject) raises -> String:
    var b = Python.import_module("builtins")
    if not b.isinstance(v, b.str):
        raise Error(String("expected a str, got ", b.type(v).__name__))
    return String(py=v)


def _to_py_String(v: String) raises -> PythonObject:
    return PythonObject(v)


def _from_py_List_String(v: PythonObject) raises -> List[String]:
    var b = Python.import_module("builtins")
    if not b.isinstance(v, b.list):
        raise Error(String("expected a list, got ", b.type(v).__name__))
    var items = List[String]()
    for item in v:
        items.append(_from_py_String(item))
    return items^
