# JSON for Mojo units, generated by mojo-anything: EmberJson
# (https://github.com/bgreni/EmberJson, Apache-2.0, tag 0.5.0) plus the value markers of
# mojo-anything's codecs.
#
# - Non-finite floats and -0.0 cross as `{"$num": "NaN" | "Infinity" | "-Infinity" | "-0"}`:
#   build floats with `json_float`, read them with `as_float`. `write_json` turns any other
#   non-finite float into its marker too (EmberJson alone would write NaN as `null`).
# - Integers stay exact up to the 64-bit limits (`Int64` and `UInt64`). Beyond them a token is
#   read as a float, or refused with `refuse_big_ints=True` (Ruby's bignums); EmberJson refuses
#   a lone surrogate (`"\ud800"`). Nothing is changed silently.
# - Object keys keep their order. Nesting is limited to EmberJson's 1024 levels.

from emberjson import Array, Object, Value, from_json, to_json
from std.memory import bitcast
from std.utils.numerics import inf, isinf, isnan, nan

comptime JsonValue = Value
"""The JSON value a port takes and returns."""

comptime _U64_MAX = "18446744073709551615"
comptime _I64_MIN_ABS = "9223372036854775808"


def _beyond(digits: String, limit: String) -> Bool:
    """Whether the decimal `digits` (no sign, no leading zeros) exceed `limit`."""
    var d = len(digits.as_bytes())
    var l = len(limit.as_bytes())
    if d != l:
        return d > l
    return digits > limit


def _refuse_big_ints(text: String) raises:
    """Raises for an integer token beyond the 64-bit limits, which EmberJson reads as a float."""
    var b = text.as_bytes()
    var i = 0
    var n = len(b)
    while i < n:
        var c = b[i]
        if c == 34:
            i += 1
            while i < n and b[i] != 34:
                i += 2 if b[i] == 92 else 1
            i += 1
            continue
        if c == 45 or (c >= 48 and c <= 57):
            var start = i
            var negative = c == 45
            if negative:
                i += 1
            var digits_start = i
            while i < n and b[i] >= 48 and b[i] <= 57:
                i += 1
            var integer = not (i < n and (b[i] == 46 or b[i] == 101 or b[i] == 69))
            if integer and i > digits_start:
                var digits = String(text[byte = digits_start:i])
                var limit = _I64_MIN_ABS if negative else _U64_MAX
                if _beyond(digits, limit):
                    raise Error(
                        "json: the integer "
                        + String(text[byte = start:i])
                        + " at byte "
                        + String(start)
                        + " is beyond 64 bits, which mojo-anything's JSON does not carry yet"
                    )
            while i < n and b[i] != 44 and b[i] != 93 and b[i] != 125 and b[i] > 32:
                i += 1
            continue
        i += 1


def parse_json(text: String, refuse_big_ints: Bool = False) raises -> Value:
    """Reads one JSON value. Raises for malformed JSON, a lone surrogate or nesting deeper than
    1024 levels.

    An integer token beyond the 64-bit limits reads as the nearest float: V8 and Go write large
    floats that way (`123456789012345680000`). Ruby writes its floats with a `.` or an exponent,
    so such a token from Ruby is a bignum, which this JSON cannot carry: its dispatcher passes
    `refuse_big_ints=True` to raise instead of changing the value."""
    if refuse_big_ints:
        _refuse_big_ints(text)
    return from_json[Value](text)


def json_float(x: Float64) -> Value:
    """`x` as a JSON value: a `$num` marker for NaN, the infinities and -0.0."""
    var marker: String
    if isnan(x):
        marker = "NaN"
    elif isinf(x):
        marker = "Infinity" if x > 0 else "-Infinity"
    elif x == 0.0 and (bitcast[DType.uint64](x) >> 63) == 1:
        marker = "-0"
    else:
        return Value(x)
    var o = Object()
    o["$num"] = Value(marker)
    return Value(o^)


def as_float(v: Value) raises -> Float64:
    """The number `v` holds, reading `$num` markers and integers."""
    if v.is_float():
        return v.float()
    if v.is_int():
        return v.int().cast[DType.float64]()
    if v.is_uint():
        return v.uint().cast[DType.float64]()
    if v.is_object() and len(v.object()) == 1 and "$num" in v.object():
        ref m = v.object()["$num"]
        if m.is_string():
            var s = m.string()
            if s == "NaN":
                return nan[DType.float64]()
            if s == "Infinity":
                return inf[DType.float64]()
            if s == "-Infinity":
                return -inf[DType.float64]()
            if s == "-0":
                return -0.0
    raise Error("json: expected a number, got " + to_json(v))


def _kind(v: Value) -> String:
    if v.is_null():
        return "null"
    if v.is_bool():
        return "a bool"
    if v.is_int() or v.is_uint() or v.is_float():
        return "a number"
    if v.is_string():
        return "a string"
    if v.is_array():
        return "an array"
    return "an object"


def json_int(v: Value, lo: Int64, hi: Int64) raises -> Int64:
    """The integer `v` holds, raising unless it lies in `lo`..`hi`."""
    var x: Int64
    if v.is_int():
        x = v.int()
    elif v.is_uint() and v.uint() <= UInt64(Int64.MAX):
        x = Int64(v.uint())
    elif v.is_uint():
        raise Error("the integer " + String(v.uint()) + " is out of range")
    else:
        raise Error("expected an integer, got " + _kind(v))
    if x < lo or x > hi:
        raise Error("the integer " + String(x) + " is out of range")
    return x


def json_uint(v: Value, hi: UInt64) raises -> UInt64:
    """The unsigned integer `v` holds, raising unless it lies in 0..`hi`."""
    var x: UInt64
    if v.is_uint():
        x = v.uint()
    elif v.is_int() and v.int() >= 0:
        x = UInt64(v.int())
    elif v.is_int():
        raise Error("the integer " + String(v.int()) + " is out of range")
    else:
        raise Error("expected an integer, got " + _kind(v))
    if x > hi:
        raise Error("the integer " + String(x) + " is out of range")
    return x


def json_string(v: Value) raises -> String:
    """The string `v` holds."""
    if not v.is_string():
        raise Error("expected a string, got " + _kind(v))
    return v.string()


def json_bool(v: Value) raises -> Bool:
    """The bool `v` holds."""
    if not v.is_bool():
        raise Error("expected a bool, got " + _kind(v))
    return v.bool()


def json_array(v: Value) raises:
    """Raises unless `v` is an array."""
    if not v.is_array():
        raise Error("expected an array, got " + _kind(v))


def _marked(v: Value) -> Value:
    """`v` with every non-finite or negative-zero float replaced by its marker."""
    if v.is_float():
        return json_float(v.float())
    if v.is_array():
        var out = Array()
        for item in v.array():
            out.append(_marked(item))
        return Value(out^)
    if v.is_object():
        var out = Object()
        for kv in v.object().items():
            out[kv.key] = _marked(kv.value)
        return Value(out^)
    return v.copy()


def write_json(v: Value) raises -> String:
    """`v` as compact JSON, with `$num` markers for non-finite floats and -0.0."""
    return to_json(_marked(v))
