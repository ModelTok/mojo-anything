# The JSON dispatcher for the Mojo port of `textkit/textkit.go`, generated by mojo-anything. Regenerate
# with `mojo-anything refresh`.

from std.ffi import external_call
from std.memory import Pointer

from emberjson import Array, Object
from json import JsonValue, as_float, json_array, json_bool, json_float, json_int, json_string, json_uint, parse_json, write_json

import port


def _undefined() raises -> JsonValue:
    # JS's `undefined`, as the TS codec carries it.
    var o = Object()
    o["$undefined"] = JsonValue(True)
    return JsonValue(o^)

def _bytes_text(p: Optional[Pointer[Int8, ImmutAnyOrigin]]) -> String:
    # SAFETY: the caller passes NULL or a NUL-terminated string valid for the call. The bytes
    # are UTF-8 JSON; they are copied as they are.
    if not p:
        return String()
    var ptr = p.value().unsafe_bitcast[UInt8]()
    var n = 0
    while ptr[unsafe_offset=n] != 0:
        n += 1
    return String(
        unsafe_from_utf8=Span[UInt8, ImmutAnyOrigin](unsafe_ptr=ptr, length=n)
    )


def _answer(s: String) -> Optional[Pointer[Int8, MutAnyOrigin]]:
    var b = s.as_bytes()
    var n = len(b)
    var p = external_call["malloc", Optional[Pointer[UInt8, MutAnyOrigin]]](n + 1)
    if not p:
        return None
    var q = p.value()
    for i in range(n):
        q[unsafe_offset=i] = b[i]
    q[unsafe_offset=n] = 0
    return q.unsafe_bitcast[Int8]()


def _tagged(tag: String, message: String) -> String:
    var o = Object()
    o[tag] = JsonValue(message)
    try:
        return write_json(JsonValue(o^))
    except:
        return '{"panic":"the dispatcher could not write its answer"}'


def _panic(message: String) -> String:
    return _tagged("panic", message)


def _error(message: String) -> String:
    return _tagged("error", message)


def _ok(v: JsonValue) -> String:
    try:
        return '{"ok":' + write_json(v) + "}"
    except e:
        return _panic("the result does not write as JSON: " + String(e))


def _from_json_String(v: JsonValue) raises -> String:
    return json_string(v)


def _to_json_String(v: String) raises -> JsonValue:
    return JsonValue(String(v))


def _from_json_Int(v: JsonValue) raises -> Int:
    return Int(json_int(v, Int64.MIN, Int64.MAX))


def _to_json_Int(v: Int) raises -> JsonValue:
    return JsonValue(Int64(v))


def _from_json_UInt64(v: JsonValue) raises -> UInt64:
    return UInt64(json_uint(v, UInt64.MAX))


def _to_json_UInt64(v: UInt64) raises -> JsonValue:
    return JsonValue(UInt64(v))


def _to_json_List_String(v: List[String]) raises -> JsonValue:
    var items = Array()
    for item in v:
        items.append(_to_json_String(item))
    return JsonValue(items^)


def _from_json_Float64(v: JsonValue) raises -> Float64:
    return as_float(v)


def _to_json_Float64(v: Float64) raises -> JsonValue:
    return json_float(v)


def _to_json_Bool(v: Bool) raises -> JsonValue:
    return JsonValue(v)


def _to_json_JsonValue(v: JsonValue) raises -> JsonValue:
    return v.copy()


def _call_echo(args: Array) -> String:
    if len(args) != 1:
        return _panic("Echo takes 1 argument, got " + String(len(args)))
    var a0: String
    try:
        a0 = _from_json_String(args[0])
    except e:
        return _panic("Echo: " + String(e))
    try:
        var out = _to_json_String(port.echo(a0))
        return _ok(out)
    except e:
        return _error(String(e))


def _call_repeat(args: Array) -> String:
    if len(args) != 2:
        return _panic("Repeat takes 2 arguments, got " + String(len(args)))
    var a0: String
    var a1: Int
    try:
        a0 = _from_json_String(args[0])
        a1 = _from_json_Int(args[1])
    except e:
        return _panic("Repeat: " + String(e))
    try:
        var out = _to_json_String(port.repeat(a0, a1))
        return _ok(out)
    except e:
        return _error(String(e))


def _call_count(args: Array) -> String:
    if len(args) != 1:
        return _panic("Count takes 1 argument, got " + String(len(args)))
    var a0: String
    try:
        a0 = _from_json_String(args[0])
    except e:
        return _panic("Count: " + String(e))
    try:
        var out = _to_json_Int(port.count(a0))
        return _ok(out)
    except e:
        return _error(String(e))


def _call_add(args: Array) -> String:
    if len(args) != 2:
        return _panic("Add takes 2 arguments, got " + String(len(args)))
    var a0: UInt64
    var a1: UInt64
    try:
        a0 = _from_json_UInt64(args[0])
        a1 = _from_json_UInt64(args[1])
    except e:
        return _panic("Add: " + String(e))
    try:
        var out = _to_json_UInt64(port.add(a0, a1))
        return _ok(out)
    except e:
        return _error(String(e))


def _call_split(args: Array) -> String:
    if len(args) != 1:
        return _panic("Split takes 1 argument, got " + String(len(args)))
    var a0: String
    try:
        a0 = _from_json_String(args[0])
    except e:
        return _panic("Split: " + String(e))
    try:
        var out = _to_json_List_String(port.split(a0))
        return _ok(out)
    except e:
        return _error(String(e))


def _call_half(args: Array) -> String:
    if len(args) != 1:
        return _panic("Half takes 1 argument, got " + String(len(args)))
    var a0: Float64
    try:
        a0 = _from_json_Float64(args[0])
    except e:
        return _panic("Half: " + String(e))
    try:
        var out = _to_json_Float64(port.half(a0))
        return _ok(out)
    except e:
        return _error(String(e))


def _call_is_neg(args: Array) -> String:
    if len(args) != 1:
        return _panic("IsNeg takes 1 argument, got " + String(len(args)))
    var a0: Float64
    try:
        a0 = _from_json_Float64(args[0])
    except e:
        return _panic("IsNeg: " + String(e))
    try:
        var out = _to_json_Bool(port.is_neg(a0))
        return _ok(out)
    except e:
        return _error(String(e))


def _call_pair(args: Array) -> String:
    if len(args) != 1:
        return _panic("Pair takes 1 argument, got " + String(len(args)))
    var a0: String
    try:
        a0 = _from_json_String(args[0])
    except e:
        return _panic("Pair: " + String(e))
    try:
        var out = _to_json_JsonValue(port.pair(a0))
        return _ok(out)
    except e:
        return _error(String(e))


def _call(name: String, text: String) -> String:
    var args: JsonValue
    try:
        args = parse_json(text, False)
    except e:
        return _panic("the arguments are not JSON: " + String(e))
    if not args.is_array():
        return _panic("the arguments are not a JSON array")
    ref a = args.array()
    if name == "Echo":
        return _call_echo(a)
    if name == "Repeat":
        return _call_repeat(a)
    if name == "Count":
        return _call_count(a)
    if name == "Add":
        return _call_add(a)
    if name == "Split":
        return _call_split(a)
    if name == "Half":
        return _call_half(a)
    if name == "IsNeg":
        return _call_is_neg(a)
    if name == "Pair":
        return _call_pair(a)
    return _panic("unknown function: " + name)


@export
def mojo_anything_call(
    name: Optional[Pointer[Int8, ImmutAnyOrigin]],
    args: Optional[Pointer[Int8, ImmutAnyOrigin]],
) abi("C") -> Optional[Pointer[Int8, MutAnyOrigin]]:
    return _answer(_call(_bytes_text(name), _bytes_text(args)))


@export
def mojo_anything_free(p: Optional[Pointer[Int8, MutAnyOrigin]]) abi("C"):
    if p:
        external_call["free", NoneType](p.value())


def _go_str(p: Optional[Pointer[UInt8, ImmutAnyOrigin]], n: UInt) -> String:
    # SAFETY: Go passes a string's bytes and length, or NULL for "". The bytes are copied as they
    # are: a Go string need not be UTF-8.
    if not p or n == 0:
        return String()
    return String(
        unsafe_from_utf8=Span[UInt8, ImmutAnyOrigin](unsafe_ptr=p.value(), length=Int(n))
    )


def _fail(err: Optional[Pointer[Int, MutAnyOrigin]], message: String) -> Int32:
    # The message for Go, allocated with malloc and freed by `mojo_anything_free`.
    var b = message.as_bytes()
    var n = len(b)
    var p = external_call["malloc", Optional[Pointer[UInt8, MutAnyOrigin]]](n + 1)
    if p and err:
        var q = p.value()
        for i in range(n):
            q[unsafe_offset=i] = b[i] if b[i] != 0 else 32
        q[unsafe_offset=n] = 0
        err.value()[] = Int(q)
    return 1


# `func Echo(s string) string`: a typed call.
@export
def mojo_anything_t_Echo(
    a0_ptr: Optional[Pointer[UInt8, ImmutAnyOrigin]], a0_len: UInt,
    res: Optional[Pointer[UInt8, MutAnyOrigin]], res_cap: UInt, res_len: Optional[Pointer[UInt, MutAnyOrigin]],
    err: Optional[Pointer[Int, MutAnyOrigin]],
) abi("C") -> Int32:
    try:
        var value = port.echo(_go_str(a0_ptr, a0_len))
        var b = value.as_bytes()
        res_len.value()[] = UInt(len(b))
        if len(b) > Int(res_cap):
            return 2
        if len(b) > 0:
            var o = res.value()
            for i in range(len(b)):
                o[unsafe_offset=i] = b[i]
        return 0
    except e:
        return _fail(err, String(e))


# `func Repeat(s string, n int) (string, error)`: a typed call.
@export
def mojo_anything_t_Repeat(
    a0_ptr: Optional[Pointer[UInt8, ImmutAnyOrigin]], a0_len: UInt,
    a1: Int64,
    res: Optional[Pointer[UInt8, MutAnyOrigin]], res_cap: UInt, res_len: Optional[Pointer[UInt, MutAnyOrigin]],
    err: Optional[Pointer[Int, MutAnyOrigin]],
) abi("C") -> Int32:
    try:
        var value = port.repeat(_go_str(a0_ptr, a0_len), Int(a1))
        var b = value.as_bytes()
        res_len.value()[] = UInt(len(b))
        if len(b) > Int(res_cap):
            return 2
        if len(b) > 0:
            var o = res.value()
            for i in range(len(b)):
                o[unsafe_offset=i] = b[i]
        return 0
    except e:
        return _fail(err, String(e))


# `func Count(s string) int`: a typed call.
@export
def mojo_anything_t_Count(
    a0_ptr: Optional[Pointer[UInt8, ImmutAnyOrigin]], a0_len: UInt,
    res: Optional[Pointer[Int64, MutAnyOrigin]],
    err: Optional[Pointer[Int, MutAnyOrigin]],
) abi("C") -> Int32:
    try:
        var value = port.count(_go_str(a0_ptr, a0_len))
        res.value()[] = Int64(value)
        return 0
    except e:
        return _fail(err, String(e))


# `func Add(a uint64, b uint64) uint64`: a typed call.
@export
def mojo_anything_t_Add(
    a0: UInt64,
    a1: UInt64,
    res: Optional[Pointer[UInt64, MutAnyOrigin]],
    err: Optional[Pointer[Int, MutAnyOrigin]],
) abi("C") -> Int32:
    try:
        var value = port.add(UInt64(a0), UInt64(a1))
        res.value()[] = UInt64(value)
        return 0
    except e:
        return _fail(err, String(e))


# `func Half(x float64) float64`: a typed call.
@export
def mojo_anything_t_Half(
    a0: Float64,
    res: Optional[Pointer[Float64, MutAnyOrigin]],
    err: Optional[Pointer[Int, MutAnyOrigin]],
) abi("C") -> Int32:
    try:
        var value = port.half(Float64(a0))
        res.value()[] = Float64(value)
        return 0
    except e:
        return _fail(err, String(e))


# `func IsNeg(x float64) bool`: a typed call.
@export
def mojo_anything_t_IsNeg(
    a0: Float64,
    res: Optional[Pointer[UInt8, MutAnyOrigin]],
    err: Optional[Pointer[Int, MutAnyOrigin]],
) abi("C") -> Int32:
    try:
        var value = port.is_neg(Float64(a0))
        res.value()[] = UInt8(1) if value else UInt8(0)
        return 0
    except e:
        return _fail(err, String(e))
