# Python bindings for the Mojo port of `src/textkit/`, generated by mojo-anything from the
# signatures in `port.mojo`. Regenerate with `mojo-anything refresh` after changing them.

from std.os import abort

from std.python import Python, PythonObject
from std.python.bindings import PythonModuleBuilder

import port
from py_num import PyNum


@export
def PyInit__native() abi("C") -> PythonObject:
    try:
        var module = PythonModuleBuilder("_native")
        module.def_function[_bind_slugify]("slugify")
        module.def_function[_bind_word_counts]("word_counts")
        module.def_function[_bind_chunk]("chunk")
        module.def_function[_bind_page_count]("page_count")
        module.def_function[_bind_mean]("mean")
        module.def_function[_bind_clipped]("clipped")
        return module.finalize()
    except e:
        abort(String("failed to create the Python module: ", e))


def _bind_slugify(p_text: PythonObject, p_sep: PythonObject, p_max_length: PythonObject) raises -> PythonObject:
    var a_text: String
    try:
        a_text = _from_py_String(p_text)
    except e:
        raise Error(String("TypeError: ", e))
    var a_sep: String
    try:
        a_sep = _from_py_String(p_sep)
    except e:
        raise Error(String("TypeError: ", e))
    var a_max_length: Optional[PyNum]
    try:
        a_max_length = _from_py_Optional_PyNum(p_max_length)
    except e:
        raise Error(String("TypeError: ", e))
    return _to_py_String(port.slugify(a_text, a_sep, a_max_length))


def _bind_word_counts(p_text: PythonObject, p_min_length: PythonObject) raises -> PythonObject:
    var a_text: String
    try:
        a_text = _from_py_String(p_text)
    except e:
        raise Error(String("TypeError: ", e))
    var a_min_length: PyNum
    try:
        a_min_length = _from_py_PyNum(p_min_length)
    except e:
        raise Error(String("TypeError: ", e))
    return _to_py_PythonObject(port.word_counts(a_text, a_min_length))


def _bind_chunk(p_items: PythonObject, p_size: PythonObject) raises -> PythonObject:
    var a_items: List[PyNum]
    try:
        a_items = _from_py_List_PyNum(p_items)
    except e:
        raise Error(String("TypeError: ", e))
    var a_size: PyNum
    try:
        a_size = _from_py_PyNum(p_size)
    except e:
        raise Error(String("TypeError: ", e))
    return _to_py_List_List_PyNum(port.chunk(a_items, a_size))


def _bind_page_count(p_total: PythonObject, p_per_page: PythonObject) raises -> PythonObject:
    var a_total: PyNum
    try:
        a_total = _from_py_PyNum(p_total)
    except e:
        raise Error(String("TypeError: ", e))
    var a_per_page: PyNum
    try:
        a_per_page = _from_py_PyNum(p_per_page)
    except e:
        raise Error(String("TypeError: ", e))
    return _to_py_PyNum(port.page_count(a_total, a_per_page))


def _bind_mean(p_values: PythonObject) raises -> PythonObject:
    var a_values: List[PyNum]
    try:
        a_values = _from_py_List_PyNum(p_values)
    except e:
        raise Error(String("TypeError: ", e))
    return _to_py_PyNum(port.mean(a_values))


def _bind_clipped(p_text: PythonObject, p_limits: PythonObject) raises -> PythonObject:
    var a_text: String
    try:
        a_text = _from_py_String(p_text)
    except e:
        raise Error(String("TypeError: ", e))
    var a_limits: Optional[PythonObject]
    try:
        a_limits = _from_py_Optional_PythonObject(p_limits)
    except e:
        raise Error(String("TypeError: ", e))
    return _to_py_String(port.clipped(a_text, a_limits))


def _from_py_String(v: PythonObject) raises -> String:
    var b = Python.import_module("builtins")
    if not b.isinstance(v, b.str):
        raise Error(String("expected a str, got ", b.type(v).__name__))
    return String(py=v)


def _from_py_PyNum(v: PythonObject) raises -> PyNum:
    var b = Python.import_module("builtins")
    if not b.isinstance(v, Python.tuple(b.int, b.float)):
        raise Error(String("expected a number, got ", b.type(v).__name__))
    return PyNum(py=v)


def _from_py_Optional_PyNum(v: PythonObject) raises -> Optional[PyNum]:
    if v is Python.none():
        return Optional[PyNum](None)
    return Optional[PyNum](_from_py_PyNum(v))


def _to_py_String(v: String) raises -> PythonObject:
    return PythonObject(v)


def _to_py_PythonObject(v: PythonObject) raises -> PythonObject:
    return v


def _from_py_List_PyNum(v: PythonObject) raises -> List[PyNum]:
    var b = Python.import_module("builtins")
    if not b.isinstance(v, b.list):
        raise Error(String("expected a list, got ", b.type(v).__name__))
    var items = List[PyNum]()
    for item in v:
        items.append(_from_py_PyNum(item))
    return items^


def _to_py_PyNum(v: PyNum) raises -> PythonObject:
    return v.to_python()


def _to_py_List_PyNum(v: List[PyNum]) raises -> PythonObject:
    var items = Python.list()
    for item in v:
        _ = items.append(_to_py_PyNum(item))
    return items


def _to_py_List_List_PyNum(v: List[List[PyNum]]) raises -> PythonObject:
    var items = Python.list()
    for item in v:
        _ = items.append(_to_py_List_PyNum(item))
    return items


def _from_py_PythonObject(v: PythonObject) raises -> PythonObject:
    return v


def _from_py_Optional_PythonObject(v: PythonObject) raises -> Optional[PythonObject]:
    if v is Python.none():
        return Optional[PythonObject](None)
    return Optional[PythonObject](_from_py_PythonObject(v))
