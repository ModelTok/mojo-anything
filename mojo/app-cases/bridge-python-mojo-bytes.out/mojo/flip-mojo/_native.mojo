# Python bindings for the Mojo port of `flip.py`, generated by mojo-anything from the
# signatures in `port.mojo`. Regenerate with `mojo-anything refresh` after changing them.

from std.os import abort

from std.python import Python, PythonObject
from std.python.bindings import PythonModuleBuilder

import port


@export
def PyInit__native() abi("C") -> PythonObject:
    try:
        var module = PythonModuleBuilder("_native")
        module.def_function[_bind_invert]("invert")
        return module.finalize()
    except e:
        abort(String("failed to create the Python module: ", e))


def _bind_invert(p_data: PythonObject, p_keep_ascii: PythonObject) raises -> PythonObject:
    var a_data: PythonObject
    try:
        a_data = _from_py_PythonObject(p_data)
    except e:
        raise Error(String("TypeError: ", e))
    var a_keep_ascii: Bool
    try:
        a_keep_ascii = _from_py_Bool(p_keep_ascii)
    except e:
        raise Error(String("TypeError: ", e))
    return _to_py_PythonObject(port.invert(a_data, a_keep_ascii))


def _from_py_PythonObject(v: PythonObject) raises -> PythonObject:
    return v


def _from_py_Bool(v: PythonObject) raises -> Bool:
    var b = Python.import_module("builtins")
    if not b.isinstance(v, b.bool):
        raise Error(String("expected a bool, got ", b.type(v).__name__))
    return Bool(v)


def _to_py_PythonObject(v: PythonObject) raises -> PythonObject:
    return v
