# C exports for the Mojo port of `src/mixed.cpp`, generated by mojo-anything from
# `mojo-anything.json`. Regenerate with `mojo-anything refresh`. These are the C
# symbols of `cpp/shim.cpp`: strings and vectors as a pointer and a length, string and
# vector results in `malloc`ed memory with their length in `len_out`, and an error
# slot a raising port writes its error to.

from std.ffi import external_call
from std.memory import Pointer
from std.os import abort

import port

def _str(
    p: Optional[Pointer[UInt8, ImmutAnyOrigin]], n: UInt, what: String
) raises -> String:
    if not p or n == 0:
        return String()
    # SAFETY: a caller of the C symbol (the wrapper, the driver, any C code) passes NULL or
    # `n` readable bytes, valid for the call; `from_utf8` checks them.
    var bytes = Span[UInt8, ImmutAnyOrigin](unsafe_ptr=p.value(), length=Int(n))
    try:
        return String(from_utf8=bytes)
    except:
        # A Mojo `String` holds UTF-8 only; the original took any bytes.
        raise Error("std::invalid_argument: " + what + " is not valid UTF-8")

def _list_int64(p: Optional[Pointer[Int64, ImmutAnyOrigin]], n: UInt) -> List[Int64]:
    var out = List[Int64](capacity=Int(n))
    if not p:
        return out^
    var ptr = p.value()
    for i in range(Int(n)):
        # SAFETY: the shim passes NULL or `n` readable elements of a `std::vector`.
        out.append(ptr[unsafe_offset=i])
    return out^

def _owned_list_int64(
    v: List[Int64], len_out: Optional[Pointer[UInt, MutAnyOrigin]]
) -> Int:
    var n = len(v)
    # SAFETY: `malloc`ed for the caller, which frees it with `free`; one element at least,
    # so an empty vector is not NULL.
    var p = external_call["malloc", Optional[Pointer[Int64, MutAnyOrigin]]](
        max(n, 1) * 8
    )
    if not p:
        abort("out of memory")
    var dst = p.value()
    for i in range(n):
        # SAFETY: `dst` holds `n` elements.
        dst[unsafe_offset=i] = v[i]
    if len_out:
        # SAFETY: the shim passes a valid `size_t *`.
        len_out.value()[] = UInt(n)
    return Int(dst)

def _set_error(slot: Optional[Pointer[Int, MutAnyOrigin]], text: String):
    if not slot:
        return
    var n = text.byte_length()
    # SAFETY: `malloc`ed for the caller, which frees it with `free`.
    var p = external_call["malloc", Optional[Pointer[UInt8, MutAnyOrigin]]](
        n + 1
    )
    if not p:
        abort("out of memory")
    var dst = p.value()
    var src = text.as_bytes()
    for i in range(n):
        # SAFETY: `dst` holds `n + 1` bytes.
        dst[unsafe_offset=i] = src[i]
    # SAFETY: as above; the text ends with a NUL.
    dst[unsafe_offset=n] = 0
    # SAFETY: the shim passes a valid `char **`.
    slot.value()[] = Int(dst)


# `long sum_long(const std::vector<long> &xs)` (`src/mixed.cpp:19`).
@export
def cpp__mixed__sum_long(
    a_xs: Optional[Pointer[Int64, ImmutAnyOrigin]],
    a_xs_len: UInt,
    a_mojo_anything_error: Optional[Pointer[Int, MutAnyOrigin]],
) abi("C") -> Int64:
    return port.sum_long(_list_int64(a_xs, a_xs_len))


