# `std::vector<long> twice_long(const std::vector<long> &xs)` (`src/mixed.cpp:35`).
@export
def cpp__mixed__twice_long(
    a_xs: Optional[Pointer[Int64, ImmutAnyOrigin]],
    a_xs_len: UInt,
    a_mojo_anything_len: Optional[Pointer[UInt, MutAnyOrigin]],
    a_mojo_anything_error: Optional[Pointer[Int, MutAnyOrigin]],
) abi("C") -> Int:
    return _owned_list_int64(port.twice_long(_list_int64(a_xs, a_xs_len)), a_mojo_anything_len)


