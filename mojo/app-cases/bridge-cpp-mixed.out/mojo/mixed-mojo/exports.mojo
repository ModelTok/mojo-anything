# `std::size_t length(const std::string &s)` (`src/mixed.cpp:70`).
@export
def cpp__mixed__length(
    a_s: Optional[Pointer[UInt8, ImmutAnyOrigin]],
    a_s_len: UInt,
    a_mojo_anything_error: Optional[Pointer[Int, MutAnyOrigin]],
) abi("C") -> UInt:
    try:
        return port.length(_str(a_s, a_s_len, "`s` of `mixed::length`"))
    except e:
        _set_error(a_mojo_anything_error, String(e))
        return 0
