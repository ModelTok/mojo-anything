        return _error(String(e))


def _call(name: String, text: String) -> String:
    var args: JsonValue
    try:
        args = parse_json(text, False)
    except e:
        return _panic("the arguments are not JSON: " + String(e))
    if not args.is_array():
        return _panic("the arguments are not a JSON array")
    ref a = args.array()
    if name == "toRadix":
        return _call_to_radix(a)
    if name == "parseRadix":
        return _call_parse_radix(a)
    if name == "toBinary":
        return _call_to_binary(a)
    if name == "toHex":
        return _call_to_hex(a)
    if name == "reverseBits":
        return _call_reverse_bits(a)
    if name == "floorMod":
        return _call_floor_mod(a)
    if name == "addExact":
        return _call_add_exact(a)
    if name == "formatDouble":
        return _call_format_double(a)
    if name == "urlEncode":
        return _call_url_encode(a)
    if name == "base64":
        return _call_base64(a)
    if name == "upper":
        return _call_upper(a)
    return _panic("unknown function: " + name)


@export
def mojo_anything_call(
    name: Optional[Pointer[Int8, ImmutAnyOrigin]],
    args: Optional[Pointer[Int8, ImmutAnyOrigin]],
) abi("C") -> Optional[Pointer[Int8, MutAnyOrigin]]:
    return _answer(_call(_bytes_text(name), _bytes_text(args)))


@export
def mojo_anything_free(p: Optional[Pointer[Int8, MutAnyOrigin]]) abi("C"):
    if p:
        external_call["free", NoneType](p.value())
