# C exports for the Mojo port of `src/checksum.c`, generated by mojo-anything from
# `mojo-anything.json`. Regenerate with `mojo-anything refresh`. Every pointer the port's
# functions see as a span or an optional value is read and written here.

from std.memory import Pointer
from std.os import abort

import port


def _c_str(
    p: Optional[Pointer[Int8, ImmutAnyOrigin]],
) -> Optional[Span[UInt8, ImmutAnyOrigin]]:
    # SAFETY: the C caller passes NULL or a NUL-terminated string valid for the call.
    if not p:
        return None
    var ptr = p.value()
    var n = 0
    while ptr[unsafe_offset=n] != 0:
        n += 1
    return Span[UInt8, ImmutAnyOrigin](
        unsafe_ptr=ptr.unsafe_bitcast[UInt8](), length=n
    )


# `uint32_t adler32(const char *data)` (`src/checksum.c:5`).
@export
def mojo_anything_adler32(a_data: Optional[Pointer[Int8, ImmutAnyOrigin]]) abi("C") -> UInt32:
    var result = port.adler32(_c_str(a_data))
    return result


