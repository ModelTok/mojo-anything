# Python bindings for the Mojo port of `src/names/`, generated by mojo-anything from the
# signatures in `port.mojo`. Regenerate with `mojo-anything refresh` after changing them.

from std.os import abort

from std.python import Python, PythonObject
from std.python.bindings import PythonModuleBuilder

import port
from py_num import PyNum


@export
def PyInit__native() abi("C") -> PythonObject:
    try:
        var module = PythonModuleBuilder("_native")
        module.def_function[_bind_pick]("pick")
        module.def_function[_bind_match_]("match")
        module.def_function[_bind_lengths]("lengths")
        module.def_function[_bind_spin]("spin")
        return module.finalize()
    except e:
        abort(String("failed to create the Python module: ", e))


def _bind_pick(p_type: PythonObject, p_out_: PythonObject, p_port: PythonObject) raises -> PythonObject:
    var a_type: String
    try:
        a_type = _from_py_String(p_type)
    except e:
        raise Error(String("TypeError: ", e))
    var a_out_: String
    try:
        a_out_ = _from_py_String(p_out_)
    except e:
        raise Error(String("TypeError: ", e))
    var a_port: String
    try:
        a_port = _from_py_String(p_port)
    except e:
        raise Error(String("TypeError: ", e))
    return _to_py_String(port.pick(a_type, a_out_, a_port))


def _bind_match_(p_case_: PythonObject) raises -> PythonObject:
    var a_case_: String
    try:
        a_case_ = _from_py_String(p_case_)
    except e:
        raise Error(String("TypeError: ", e))
    return _to_py_String(port.match_(a_case_))


def _bind_lengths(p_items: PythonObject) raises -> PythonObject:
    var a_items: List[String]
    try:
        a_items = _from_py_List_String(p_items)
    except e:
        raise Error(String("TypeError: ", e))
    return _to_py_List_PyNum(port.lengths(a_items))


def _bind_spin(p_n: PythonObject) raises -> PythonObject:
    var a_n: PyNum
    try:
        a_n = _from_py_PyNum(p_n)
    except e:
        raise Error(String("TypeError: ", e))
    return _to_py_PyNum(port.spin(a_n))


def _from_py_String(v: PythonObject) raises -> String:
    var b = Python.import_module("builtins")
    if not b.isinstance(v, b.str):
        raise Error(String("expected a str, got ", b.type(v).__name__))
    return String(py=v)


def _to_py_String(v: String) raises -> PythonObject:
    return PythonObject(v)


def _from_py_List_String(v: PythonObject) raises -> List[String]:
    var b = Python.import_module("builtins")
    if not b.isinstance(v, b.list):
        raise Error(String("expected a list, got ", b.type(v).__name__))
    var items = List[String]()
    for item in v:
        items.append(_from_py_String(item))
    return items^


def _to_py_PyNum(v: PyNum) raises -> PythonObject:
    return v.to_python()


def _to_py_List_PyNum(v: List[PyNum]) raises -> PythonObject:
    var items = Python.list()
    for item in v:
        _ = items.append(_to_py_PyNum(item))
    return items


def _from_py_PyNum(v: PythonObject) raises -> PyNum:
    var b = Python.import_module("builtins")
    if not b.isinstance(v, Python.tuple(b.int, b.float)):
        raise Error(String("expected a number, got ", b.type(v).__name__))
    return PyNum(py=v)
