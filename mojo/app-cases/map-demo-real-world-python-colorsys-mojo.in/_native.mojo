# Python bindings for the Mojo port of `src/colorsys_pkg/`, generated by mojo-anything from the
# signatures in `port.mojo`. Regenerate with `mojo-anything refresh` after changing them.

from std.os import abort

from std.python import Python, PythonObject
from std.python.bindings import PythonModuleBuilder

import port
from py_num import PyNum


@export
def PyInit__native() abi("C") -> PythonObject:
    try:
        var module = PythonModuleBuilder("_native")
        module.def_function[_bind_rgb_to_yiq]("rgb_to_yiq")
        module.def_function[_bind_yiq_to_rgb]("yiq_to_rgb")
        module.def_function[_bind_rgb_to_hls]("rgb_to_hls")
        module.def_function[_bind_hls_to_rgb]("hls_to_rgb")
        module.def_function[_bind_rgb_to_hsv]("rgb_to_hsv")
        module.def_function[_bind_hsv_to_rgb]("hsv_to_rgb")
        return module.finalize()
    except e:
        abort(String("failed to create the Python module: ", e))


def _bind_rgb_to_yiq(r: PythonObject, g: PythonObject, b: PythonObject) raises -> PythonObject:
    var a_r: PyNum
    try:
        a_r = _from_py_PyNum(r)
    except e:
        raise Error(String("TypeError: ", e))
    var a_g: PyNum
    try:
        a_g = _from_py_PyNum(g)
    except e:
        raise Error(String("TypeError: ", e))
    var a_b: PyNum
    try:
        a_b = _from_py_PyNum(b)
    except e:
        raise Error(String("TypeError: ", e))
    return _to_py_PythonObject(port.rgb_to_yiq(a_r, a_g, a_b))


