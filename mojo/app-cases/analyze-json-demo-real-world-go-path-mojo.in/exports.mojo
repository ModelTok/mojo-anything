# `func IsAbs(path string) bool`: a typed call.
@export
def mojo_anything_t_IsAbs(
    a0_ptr: Optional[Pointer[UInt8, ImmutAnyOrigin]], a0_len: UInt,
    res: Optional[Pointer[UInt8, MutAnyOrigin]],
    err: Optional[Pointer[Int, MutAnyOrigin]],
) abi("C") -> Int32:
    try:
        var value = port.is_abs(_go_str(a0_ptr, a0_len))
        res.value()[] = UInt8(1) if value else UInt8(0)
        return 0
    except e:
        return _fail(err, String(e))


