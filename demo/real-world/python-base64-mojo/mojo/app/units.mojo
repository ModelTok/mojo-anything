from glue import b64codec


def dispatch(command: String, args: List[String]) raises -> Optional[Int]:
    """The exit code of the unit that answers `command`, or None to run the
    original. `args` holds every argument after the program name."""
    if command == "base64":
        return b64codec.base64(args)
    return None
